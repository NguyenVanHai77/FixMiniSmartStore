@page
@model MiniSmartstoreMvc.Areas.Identity.Pages.Account.ForgotPasswordModel

@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />

    <title>Quên mật khẩu - MiniSmartstore</title>

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/auth-double.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/auth-double.css"
          asp-append-version="true" />

    @* ===== LƯU Ý: SỬA NÚT ĐĂNG NHẬP TRANG QUÊN MẬT KHẨU ===== *@
    <style>
            .auth-forgot-login-btn {
                width: 230px;
                height: 58px;
                padding: 0 !important;
                border: 2px solid #ffffff;
                border-radius: 999px;
                background: transparent;
                color: #ffffff !important;
                text-decoration: none !important;
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
                font-size: 17px;
                font-weight: 800;
                line-height: 1;
            }

                .auth-forgot-login-btn:hover {
                    color: #ffffff !important;
                    text-decoration: none !important;
                    background: rgba(255, 255, 255, 0.08);
                }
    </style>
    @* ===== KẾT THÚC SỬA NÚT ĐĂNG NHẬP TRANG QUÊN MẬT KHẨU ===== *@
</head>

<body class="auth-double-body">

    <div class="auth-back-home">
        <a asp-area=""
           asp-controller="Home"
           asp-action="Index">
            ← Quay lại trang chủ
        </a>
    </div>

    <div class="auth-double-container">

        <!-- FORM QUÊN MẬT KHẨU -->
        <div class="auth-form-container auth-sign-in-container">

            <form method="post"
                  class="auth-form">

                @Html.AntiForgeryToken()

                <h1>Quên mật khẩu</h1>

                <p class="auth-subtitle">
                    Nhập email đã đăng ký để nhận mã OTP xác minh.
                </p>

                <div asp-validation-summary="ModelOnly"
                     class="text-danger auth-validation">
                </div>

                <label>Email</label>

                <div class="auth-input-group">

                    <span>✉️</span>

                    <input asp-for="Input.Email"
                           placeholder="Nhập email của bạn"
                           autocomplete="email"
                           aria-required="true" />

                </div>

                <span asp-validation-for="Input.Email"
                      class="text-danger">
                </span>

                <button type="submit"
                        class="auth-main-btn">
                    Gửi mã xác minh
                </button>

                <div class="auth-mobile-switch">

                    Đã nhớ mật khẩu?

                    <a asp-page="./Login">
                        Quay lại đăng nhập
                    </a>

                </div>

            </form>

        </div>


        <!-- PHẦN MÀU XANH BÊN PHẢI -->
        <div class="auth-overlay-container">

            <div class="auth-overlay">

                <div class="auth-overlay-panel auth-overlay-left">

                    <div class="auth-logo-box">
                        <img src="~/images/logo/minismartstore-logo1.png"
                             asp-append-version="true"
                             alt="MiniSmartstore"
                             class="auth-logo-img" />
                        <strong>MiniSmartstore</strong>
                    </div>

                    <h1>Chào mừng trở lại!</h1>

                    <p>
                        Nếu bạn đã có tài khoản, hãy đăng nhập
                        để tiếp tục mua sắm và quản lý đơn hàng.
                    </p>

                </div>


                <div class="auth-overlay-panel auth-overlay-right">

                    <div class="auth-logo-box">

                        <img src="~/images/logo/minismartstore-logo1.png"
                             asp-append-version="true"
                             alt="MiniSmartstore"
                             class="auth-logo-img" />

                        <strong>
                            MiniSmartstore
                        </strong>

                    </div>

                    <h1>Khôi phục tài khoản</h1>

                    <p>
                        Chúng tôi sẽ gửi mã OTP đến email
                        đã đăng ký để xác minh và giúp bạn
                        đặt lại mật khẩu.
                    </p>

                    <a asp-page="./Login"
                       class="auth-ghost-btn auth-forgot-login-btn">
                        Đăng nhập
                    </a>

                </div>

            </div>

        </div>

    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <partial name="_ValidationScriptsPartial" />

</body>
</html>
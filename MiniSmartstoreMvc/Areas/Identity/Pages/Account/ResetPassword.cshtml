@page
@model MiniSmartstoreMvc.Areas.Identity.Pages.Account.ResetPasswordModel

@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />

    <title>Đặt lại mật khẩu - MiniSmartstore</title>

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/auth-double.css"
          asp-append-version="true" />

    @* ===== LƯU Ý: CSS RIÊNG CHO TRANG ĐẶT LẠI MẬT KHẨU ===== *@
    <style>
            .auth-reset-login-btn {
                width: 230px;
                height: 58px;
                padding: 0 !important;
                border: 2px solid #ffffff;
                border-radius: 999px;
                background: transparent;
                color: #ffffff !important;
                text-decoration: none !important;
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
                font-size: 17px;
                font-weight: 800;
                line-height: 1;
            }

                .auth-reset-login-btn:hover {
                    color: #ffffff !important;
                    text-decoration: none !important;
                    background: rgba(255, 255, 255, 0.08);
                }

            .auth-reset-note {
                margin-top: 16px;
                color: #7c879a;
                font-size: 14px;
                line-height: 1.5;
            }
    </style>
    @* ===== KẾT THÚC CSS RIÊNG CHO TRANG ĐẶT LẠI MẬT KHẨU ===== *@
</head>

<body class="auth-double-body">

    <div class="auth-back-home">
        <a asp-area=""
           asp-controller="Home"
           asp-action="Index">
            ← Quay lại trang chủ
        </a>
    </div>

    <div class="auth-double-container">

        <!-- PHẦN BÊN TRÁI -->
        <div class="auth-form-container auth-sign-in-container">

            <form method="post"
                  class="auth-form">

                @Html.AntiForgeryToken()

                <h1>
                    Đặt lại mật khẩu
                </h1>

                <p class="auth-subtitle">
                    Tạo mật khẩu mới cho tài khoản của bạn.
                </p>

                <div asp-validation-summary="ModelOnly"
                     class="text-danger auth-validation">
                </div>


                <label>
                    Mật khẩu mới
                </label>

                <div class="auth-input-group">

                    <span>🔒</span>

                    <input asp-for="Input.Password"
                           placeholder="Nhập mật khẩu mới"
                           autocomplete="new-password"
                           aria-required="true" />

                </div>

                <span asp-validation-for="Input.Password"
                      class="text-danger">
                </span>


                <label>
                    Xác nhận mật khẩu
                </label>

                <div class="auth-input-group">

                    <span>🔒</span>

                    <input asp-for="Input.ConfirmPassword"
                           placeholder="Nhập lại mật khẩu mới"
                           autocomplete="new-password"
                           aria-required="true" />

                </div>

                <span asp-validation-for="Input.ConfirmPassword"
                      class="text-danger">
                </span>


                <button type="submit"
                        class="auth-main-btn">
                    Đổi mật khẩu
                </button>


                <div class="auth-reset-note">
                    Sau khi đổi mật khẩu thành công,
                    bạn sẽ được chuyển về trang đăng nhập.
                </div>

            </form>

        </div>


        <!-- PHẦN MÀU XANH BÊN PHẢI -->
        <div class="auth-overlay-container">

            <div class="auth-overlay">

                <div class="auth-overlay-panel auth-overlay-left">

                    <div class="auth-logo-box">

                        <img src="~/images/logo/minismartstore-logo1.png"
                             asp-append-version="true"
                             alt="MiniSmartstore"
                             class="auth-logo-img" />

                        <strong>
                            MiniSmartstore
                        </strong>

                    </div>

                    <h1>
                        Chào mừng trở lại!
                    </h1>

                    <p>
                        Nếu bạn đã có tài khoản,
                        hãy đăng nhập để tiếp tục mua sắm
                        và quản lý đơn hàng.
                    </p>

                </div>


                <div class="auth-overlay-panel auth-overlay-right">

                    <div class="auth-logo-box">

                        <img src="~/images/logo/minismartstore-logo1.png"
                             asp-append-version="true"
                             alt="MiniSmartstore"
                             class="auth-logo-img" />

                        <strong>
                            MiniSmartstore
                        </strong>

                    </div>

                    <h1>
                        Tạo mật khẩu mới
                    </h1>

                    <p>
                        Hãy tạo mật khẩu mới an toàn cho tài khoản.
                        Sau khi hoàn tất, bạn có thể sử dụng mật khẩu
                        mới để đăng nhập vào MiniSmartstore.
                    </p>

                    <a asp-page="./Login"
                       class="auth-ghost-btn auth-reset-login-btn">
                        Đăng nhập
                    </a>

                </div>

            </div>

        </div>

    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <partial name="_ValidationScriptsPartial" />

</body>
</html>
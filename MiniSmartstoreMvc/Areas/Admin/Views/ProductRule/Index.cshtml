@using MiniSmartstoreMvc.Models
@model IEnumerable<ProductRule>

@{
    ViewData["Title"] = "Quy tắc sản phẩm";
}

<div class="admin-product-page">
    <div class="admin-product-title-row">
        <div>
            <h2>Quy tắc sản phẩm</h2>
            <p class="text-muted mb-0">
                Tạo các quy tắc tự động cho sản phẩm như giảm giá, nổi bật, ẩn hoặc hiện sản phẩm theo thời gian.
            </p>
        </div>

        <div class="d-flex gap-2">
            <form asp-area="Admin" asp-controller="ProductRule" asp-action="ApplyNow" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary">
                    Áp dụng lại quy tắc
                </button>
            </form>

            <a asp-area="Admin"
               asp-controller="ProductRule"
               asp-action="Create"
               class="btn btn-primary">
                + Thêm quy tắc
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="smart-manage-card">
        <div class="smart-table-scroll">
            <table class="table smart-product-table">
                <thead>
                    <tr>
                        <th>Tên quy tắc</th>
                        <th>Loại quy tắc</th>
                        <th>Áp dụng cho</th>
                        <th>Giảm giá</th>
                        <th>Thời gian</th>
                        <th>Ưu tiên</th>
                        <th>Trạng thái</th>
                        <th style="width: 80px;"></th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@item.RuleName</strong>

                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <div class="text-muted small">@item.Description</div>
                                    }
                                </td>

                                <td>@ActionText(item.ActionType)</td>

                                <td>@TargetText(item)</td>

                                <td>
                                    @if (item.ActionType == ProductRuleActionType.Discount)
                                    {
                                        if (item.DiscountType == DiscountType.Percentage)
                                        {
                                            <span>@item.DiscountValue.ToString("N0")%</span>
                                        }
                                        else
                                        {
                                            <span>@item.DiscountValue.ToString("N0") đ</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">Không áp dụng</span>
                                    }
                                </td>

                                <td>
                                    <div>@item.StartDate.ToString("dd/MM/yyyy HH:mm")</div>
                                    <div class="text-muted small">đến @item.EndDate.ToString("dd/MM/yyyy HH:mm")</div>
                                </td>

                                <td>@item.Priority</td>

                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Đang bật</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Đang tắt</span>
                                    }
                                </td>

                                <td>
                                    <div class="dropdown">
                                        <button type="button"
                                                class="product-row-more"
                                                data-bs-toggle="dropdown">
                                            ⋯
                                        </button>

                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <a class="dropdown-item"
                                                   asp-area="Admin"
                                                   asp-controller="ProductRule"
                                                   asp-action="Edit"
                                                   asp-route-id="@item.Id">
                                                    Sửa quy tắc
                                                </a>
                                            </li>

                                            <li>
                                                <form asp-area="Admin"
                                                      asp-controller="ProductRule"
                                                      asp-action="ToggleActive"
                                                      asp-route-id="@item.Id"
                                                      method="post">
                                                    @Html.AntiForgeryToken()

                                                    <button type="submit" class="dropdown-item">
                                                        @(item.IsActive ? "Tắt quy tắc" : "Bật quy tắc")
                                                    </button>
                                                </form>
                                            </li>
                                            <li>
                                                <button type="button"
                                                        class="dropdown-item text-danger btn-open-rule-delete"
                                                        data-id="@item.Id"
                                                        data-name="@item.RuleName">
                                                    Xóa quy tắc
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center p-4">
                                Chưa có quy tắc sản phẩm nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@functions {
    private string ActionText(ProductRuleActionType actionType)
    {
        return actionType switch
        {
            ProductRuleActionType.Discount => "Giảm giá",
            ProductRuleActionType.MarkAsFeatured => "Đánh dấu nổi bật",
            ProductRuleActionType.HideProduct => "Ẩn sản phẩm",
            ProductRuleActionType.ShowProduct => "Hiện sản phẩm",
            _ => actionType.ToString()
        };
    }

    private string TargetText(ProductRule item)
    {
        if (item.TargetType == ProductRuleTargetType.AllProducts)
        {
            return "Toàn bộ sản phẩm";
        }

        if (item.TargetType == ProductRuleTargetType.Category)
        {
            return "Danh mục: " + (item.Category?.Name ?? "Không xác định");
        }

        if (item.TargetType == ProductRuleTargetType.Product)
        {
            return "Sản phẩm: " + (item.Product?.Name ?? "Không xác định");
        }

        return "Không xác định";
    }
}

<style>
    .rule-delete-overlay {
        position: fixed;
        inset: 0;
        z-index: 99999;
        display: none;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.45);
        padding: 20px;
    }

        .rule-delete-overlay.show {
            display: flex;
        }

    .rule-delete-modal {
        position: relative;
        width: 540px;
        max-width: 100%;
        padding: 30px 32px 26px;
        background: #fff;
        border-radius: 6px;
        box-shadow: 0 14px 45px rgba(0, 0, 0, 0.25);
    }

        .rule-delete-modal h2 {
            margin: 0 0 22px;
            font-size: 24px;
            font-weight: 600;
            color: #333;
        }

        .rule-delete-modal p {
            margin: 0 0 20px;
            font-size: 16px;
            color: #555;
        }

    .rule-delete-close {
        position: absolute;
        top: 14px;
        right: 18px;
        width: 36px;
        height: 36px;
        border: none;
        background: transparent;
        font-size: 30px;
        color: #999;
        cursor: pointer;
    }

    .rule-delete-info {
        padding: 16px;
        margin-bottom: 16px;
        border: 1px solid #e5e7eb;
        border-radius: 6px;
        background: #f8fafc;
    }

    .rule-delete-warning {
        padding: 12px 14px;
        margin-bottom: 26px;
        border-radius: 5px;
        background: #fff7ed;
        color: #9a3412;
        font-size: 14px;
    }

    .rule-delete-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 12px;
    }

        .rule-delete-actions form {
            margin: 0;
        }

    .rule-delete-cancel {
        min-width: 90px;
        height: 44px;
        border: none;
        background: transparent;
        font-size: 16px;
        color: #777;
        cursor: pointer;
    }

    .rule-delete-confirm {
        min-width: 120px;
        height: 44px;
        border: none;
        border-radius: 3px;
        background: #ee4d2d;
        color: white;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
    }

        .rule-delete-confirm:hover {
            background: #d94325;
        }
</style>

<!-- Modal xác nhận xóa quy tắc -->
<div id="ruleDeleteModal" class="rule-delete-overlay">
    <div class="rule-delete-modal">

        <button type="button"
                id="closeRuleDeleteModal"
                class="rule-delete-close">
            ×
        </button>

        <h2>Xóa quy tắc</h2>

        <p>Bạn có chắc muốn xóa quy tắc này?</p>

        <div class="rule-delete-info">
            <strong id="ruleDeleteName"></strong>
        </div>

        <div class="rule-delete-warning">
            Sau khi xóa, quy tắc này sẽ không còn được áp dụng cho sản phẩm.
        </div>

        <div class="rule-delete-actions">

            <button type="button"
                    id="cancelRuleDeleteModal"
                    class="rule-delete-cancel">
                Hủy
            </button>

            <form asp-area="Admin"
                  asp-controller="ProductRule"
                  asp-action="Delete"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       id="ruleDeleteId"
                       name="id" />

                <button type="submit"
                        class="rule-delete-confirm">
                    Xác nhận
                </button>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        const ruleDeleteModal =
            document.getElementById("ruleDeleteModal");

        const ruleDeleteId =
            document.getElementById("ruleDeleteId");

        const ruleDeleteName =
            document.getElementById("ruleDeleteName");

        const closeRuleDeleteModal =
            document.getElementById("closeRuleDeleteModal");

        const cancelRuleDeleteModal =
            document.getElementById("cancelRuleDeleteModal");

        document.querySelectorAll(".btn-open-rule-delete")
            .forEach(function (button) {

                button.addEventListener("click", function () {
                    ruleDeleteId.value = this.dataset.id;
                    ruleDeleteName.textContent = this.dataset.name;

                    ruleDeleteModal.classList.add("show");
                });
            });

        function hideRuleDeleteModal() {
            ruleDeleteModal.classList.remove("show");
        }

        if (closeRuleDeleteModal) {
            closeRuleDeleteModal.addEventListener(
                "click",
                hideRuleDeleteModal
            );
        }

        if (cancelRuleDeleteModal) {
            cancelRuleDeleteModal.addEventListener(
                "click",
                hideRuleDeleteModal
            );
        }

        if (ruleDeleteModal) {
            ruleDeleteModal.addEventListener("click", function (event) {
                if (event.target === ruleDeleteModal) {
                    hideRuleDeleteModal();
                }
            });
        }
    </script>
}
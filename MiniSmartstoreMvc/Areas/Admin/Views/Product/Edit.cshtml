@model MiniSmartstoreMvc.Models.Product

@{
    ViewData["Title"] = "Sửa sản phẩm";
    ViewBag.IsEdit = true;
}

<div class="admin-product-form-page">
    <div class="admin-product-form-card">
        <div class="admin-product-form-header">
            <div class="admin-product-heading">
                <a asp-area="Admin"
                   asp-controller="Product"
                   asp-action="Index"
                   class="apf-back"
                   title="Quay lại"></a>

                <div>
                    <h1>Sửa sản phẩm - @Model.Name</h1>
                    <p>Cập nhật thông tin, giá bán, kho hàng, hình ảnh, danh mục và SEO.</p>
                </div>
            </div>

            <div class="admin-product-actions">
                <a asp-area=""
                   asp-controller="Product"
                   asp-action="Details"
                   asp-route-id="@Model.Id"
                   target="_blank"
                   class="apf-btn apf-btn-soft">
                    Xem ngoài shop
                </a>

                <button type="submit"
                        form="productForm"
                        name="saveMode"
                        value="save"
                        class="apf-btn apf-btn-primary">
                    Lưu
                </button>

                <button type="submit"
                        form="productForm"
                        name="saveMode"
                        value="continue"
                        class="apf-btn apf-btn-soft">
                    Lưu và tiếp tục sửa
                </button>

                <button type="button"
                        id="openEditProductDeleteModal"
                        class="apf-btn apf-btn-danger">
                    Xóa
                </button>
            </div>
        </div>

        <partial name="_Form" model="Model" />
        <form id="productImageActionForm" method="post">
            @Html.AntiForgeryToken()
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            initAdminProductTabs();
            initAdminProductImagePreview();
            initAdminProductPricePreview();
            initProductImageActionButtons();

            // ===== LƯU Ý: KHỞI TẠO MODAL XÓA SẢN PHẨM =====
            initEditProductDeleteModal();
            // ===== KẾT THÚC KHỞI TẠO MODAL XÓA SẢN PHẨM =====
        });
                // ===== LƯU Ý: XỬ LÝ MODAL XÓA SẢN PHẨM =====
        function initEditProductDeleteModal() {

            const modal =
                document.getElementById("editProductDeleteModal");

            const openButton =
                document.getElementById("openEditProductDeleteModal");

            const closeButton =
                document.getElementById("closeEditProductDeleteModal");

            const cancelButton =
                document.getElementById("cancelEditProductDeleteModal");

            if (!modal || !openButton) {
                return;
            }

            function showModal() {
                modal.classList.add("show");
            }

            function hideModal() {
                modal.classList.remove("show");
            }

            openButton.addEventListener(
                "click",
                showModal
            );

            if (closeButton) {
                closeButton.addEventListener(
                    "click",
                    hideModal
                );
            }

            if (cancelButton) {
                cancelButton.addEventListener(
                    "click",
                    hideModal
                );
            }

            modal.addEventListener(
                "click",
                function (event) {

                    if (event.target === modal) {
                        hideModal();
                    }

                }
            );
        }
        // ===== KẾT THÚC XỬ LÝ MODAL XÓA SẢN PHẨM =====
        function initProductImageActionButtons() {
            document.querySelectorAll(".js-product-image-action").forEach(function(button) {
                button.addEventListener("click", function() {
                    const url = this.dataset.url;
                    const confirmMessage = this.dataset.confirm;
                    const form = document.getElementById("productImageActionForm");

                    if (!url || !form) {
                        return;
                    }

                    if (confirmMessage && !confirm(confirmMessage)) {
                        return;
                    }

                    form.action = url;
                    form.submit();
                });
            });
        }
        function initAdminProductTabs() {
            document.querySelectorAll(".apf-tab").forEach(function(button) {
                button.addEventListener("click", function() {
                    const tab = this.dataset.tab;

                    document.querySelectorAll(".apf-tab").forEach(x => x.classList.remove("active"));
                    document.querySelectorAll(".apf-panel").forEach(x => x.classList.remove("active"));

                    this.classList.add("active");
                    document.getElementById(tab)?.classList.add("active");
                });
            });
        }

        function initAdminProductImagePreview() {
            const input = document.getElementById("imageFile");
            const preview = document.getElementById("previewImage");

            if (!input || !preview) return;

            input.addEventListener("change", function(event) {
                const file = event.target.files[0];
                if (!file) return;

                preview.src = URL.createObjectURL(file);
            });
        }

        function initAdminProductPricePreview() {
            const priceInput = document.getElementById("Price");
            const oldPriceInput = document.getElementById("OldPrice");
            const pricePreview = document.getElementById("apfPricePreview");
            const oldPricePreview = document.getElementById("apfOldPricePreview");
            const discountPreview = document.getElementById("apfDiscountPreview");

            function format(value) {
                const number = Number(value || 0);
                return number.toLocaleString("vi-VN") + " đ";
            }

            function update() {
                const price = Number(priceInput?.value || 0);
                const oldPrice = Number(oldPriceInput?.value || 0);

                if (pricePreview) pricePreview.textContent = format(price);
                if (oldPricePreview) oldPricePreview.textContent = oldPrice > 0 ? format(oldPrice) : "Chưa có";

                let discount = 0;
                if (oldPrice > price && oldPrice > 0) {
                    discount = Math.round(((oldPrice - price) / oldPrice) * 100);
                }

                if (discountPreview) discountPreview.textContent = discount + "%";
            }

            priceInput?.addEventListener("input", update);
            oldPriceInput?.addEventListener("input", update);
            update();
        }
    </script>

}
@* ===== LƯU Ý: MODAL XÁC NHẬN XÓA SẢN PHẨM ===== *@

<style>
    .product-delete-overlay {
        position: fixed;
        inset: 0;
        z-index: 99999;
        display: none;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.45);
        padding: 20px;
    }

        .product-delete-overlay.show {
            display: flex;
        }

    .product-delete-modal {
        position: relative;
        width: 560px;
        max-width: 100%;
        background: #ffffff;
        border-radius: 6px;
        padding: 30px 32px 26px;
        box-shadow: 0 14px 45px rgba(0, 0, 0, 0.25);
    }

        .product-delete-modal h2 {
            margin: 0 0 22px;
            font-size: 24px;
            font-weight: 600;
            color: #333;
        }

        .product-delete-modal p {
            margin: 0 0 20px;
            font-size: 16px;
            color: #555;
        }

    .product-delete-close {
        position: absolute;
        top: 14px;
        right: 18px;
        width: 36px;
        height: 36px;
        border: none;
        background: transparent;
        font-size: 30px;
        line-height: 30px;
        color: #999;
        cursor: pointer;
    }

        .product-delete-close:hover {
            color: #333;
        }

    .product-delete-info {
        display: flex;
        align-items: center;
        gap: 18px;
        min-height: 90px;
        margin-bottom: 30px;
    }

        .product-delete-info img {
            width: 82px;
            height: 82px;
            object-fit: cover;
            border: 1px solid #e5e5e5;
            border-radius: 4px;
            background: #fff;
        }

        .product-delete-info strong {
            display: block;
            font-size: 17px;
            font-weight: 600;
            color: #222;
            line-height: 1.4;
        }

    .product-delete-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 12px;
    }

        .product-delete-actions form {
            margin: 0;
        }

    .product-delete-cancel {
        min-width: 90px;
        height: 44px;
        padding: 0 18px;
        border: none;
        background: transparent;
        font-size: 16px;
        color: #777;
        cursor: pointer;
    }

        .product-delete-cancel:hover {
            color: #333;
            background: #f5f5f5;
        }

    .product-delete-confirm {
        min-width: 120px;
        height: 44px;
        padding: 0 20px;
        border: none;
        border-radius: 3px;
        background: #ee4d2d;
        color: #fff;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
    }

        .product-delete-confirm:hover {
            background: #d94325;
        }

    @@media (max-width: 600px) {
        .product-delete-modal {
            padding: 24px 20px;
        }

        .product-delete-info img {
            width: 70px;
            height: 70px;
        }

        .product-delete-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .product-delete-cancel,
        .product-delete-confirm {
            width: 100%;
        }
    }
</style>


<div id="editProductDeleteModal"
     class="product-delete-overlay">

    <div class="product-delete-modal">

        <button type="button"
                id="closeEditProductDeleteModal"
                class="product-delete-close">
            ×
        </button>

        <h2>Xóa sản phẩm</h2>

        <p>Bạn có chắc muốn xóa sản phẩm sau?</p>

        <div class="product-delete-info">

            <img src="@(string.IsNullOrWhiteSpace(Model.ImageUrl)
                                         ? "/images/products/no-image.jpg"
                                         : Model.ImageUrl)"
                 alt="@Model.Name"
                 onerror="this.src='/images/products/no-image.jpg'" />

            <div>
                <strong>@Model.Name</strong>
            </div>

        </div>

        <div class="product-delete-actions">

            <button type="button"
                    id="cancelEditProductDeleteModal"
                    class="product-delete-cancel">
                Hủy
            </button>

            <form asp-area="Admin"
                  asp-controller="Product"
                  asp-action="Delete"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.Id" />

                <button type="submit"
                        class="product-delete-confirm">
                    Xác nhận
                </button>

            </form>

        </div>

    </div>

</div>

@* ===== KẾT THÚC MODAL XÁC NHẬN XÓA SẢN PHẨM ===== *@
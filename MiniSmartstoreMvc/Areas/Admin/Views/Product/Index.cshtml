@model IEnumerable<MiniSmartstoreMvc.Models.Product>

@{
    ViewData["Title"] = "Quản lý sản phẩm";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int pageSize = ViewBag.PageSize ?? 25;
    int totalItems = ViewBag.TotalItems ?? 0;
    bool filterOpen = ViewBag.FilterOpen ?? false;
    bool? published = ViewBag.Published as bool?;

    var search = ViewBag.Search as string;
    var categoryId = ViewBag.CategoryId;
    var minPrice = ViewBag.MinPrice;
    var maxPrice = ViewBag.MaxPrice;
    var sortBy = ViewBag.SortBy;
    var now = DateTime.Now;
}

<div class="admin-product-page">
    <div class="admin-product-card">
        <div class="admin-product-header">
            <div class="admin-product-title">
                <h1>Quản lý sản phẩm</h1>
                <p>Thêm, chỉnh sửa, ẩn/hiện, lọc và quản lý tồn kho sản phẩm ngoài cửa hàng.</p>
            </div>

            <a asp-area="Admin"
               asp-controller="Product"
               asp-action="Create"
               class="admin-primary-btn">
                <span>+</span>
                <span>Thêm sản phẩm</span>
            </a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="admin-alert admin-alert-success">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="admin-alert admin-alert-danger">
                @TempData["Error"]
            </div>
        }

        <div class="admin-product-toolbar">
            <button type="button"
                    id="toggleProductFilter"
                    class="admin-filter-btn @(filterOpen ? "active" : "")"
                    title="Bộ lọc">
                <span class="admin-css-icon admin-icon-filter"></span>
            </button>

            <a asp-area="Admin"
               asp-controller="Product"
               asp-action="Create"
               class="admin-add-inline-btn">
                <span>+</span>
                <span>Thêm mới...</span>
            </a>

            @* ===== LƯU Ý: XÓA CÁC SẢN PHẨM ĐƯỢC CHỌN ===== *@
            <button type="button"
                    id="deleteSelectedProductsBtn"
                    class="admin-delete-selected-btn"
                    disabled
                    title="Hãy chọn ít nhất một sản phẩm">
                <span class="admin-css-icon admin-icon-trash"></span>
                <span>Xóa mục đã chọn</span>
            </button>
            @* ===== KẾT THÚC XÓA CÁC SẢN PHẨM ĐƯỢC CHỌN ===== *@
        </div>

        <div class="admin-product-manager @(filterOpen ? "filter-open" : "")" id="adminProductManager">
            <aside class="admin-product-filter-panel">
                <form asp-area="Admin"
                      asp-controller="Product"
                      asp-action="Index"
                      method="get">

                    <input type="hidden" name="filterOpen" value="true" />

                    <div class="admin-filter-panel-title">
                        Bộ lọc sản phẩm
                    </div>

                    <div class="admin-filter-group">
                        <label>Tên sản phẩm</label>
                        <input type="text"
                               name="search"
                               value="@search"
                               placeholder="Nhập tên sản phẩm..." />
                    </div>

                    <div class="admin-filter-group">
                        <label>Danh mục</label>
                        <select name="categoryId" asp-items="ViewBag.Categories">
                            <option value="">Tất cả danh mục</option>
                        </select>
                    </div>

                    <div class="admin-filter-group">
                        <label>Trạng thái hiển thị</label>
                        <select name="published">
                            <option value="">Không chọn</option>
                            <option value="true" selected="@(published == true ? "selected" : null)">Đang hiển thị</option>
                            <option value="false" selected="@(published == false ? "selected" : null)">Đã ẩn</option>
                        </select>
                    </div>

                    <div class="admin-filter-row">
                        <div class="admin-filter-group">
                            <label>Giá từ</label>
                            <input type="number"
                                   name="minPrice"
                                   value="@minPrice"
                                   placeholder="0" />
                        </div>

                        <div class="admin-filter-group">
                            <label>Giá đến</label>
                            <input type="number"
                                   name="maxPrice"
                                   value="@maxPrice"
                                   placeholder="1000000" />
                        </div>
                    </div>

                    <div class="admin-filter-group">
                        <label>Sắp xếp theo</label>
                        <select name="sortBy">
                            <option value="newest" selected="@(sortBy == "newest" ? "selected" : null)">Mới nhất</option>
                            <option value="name_asc" selected="@(sortBy == "name_asc" ? "selected" : null)">Tên A-Z</option>
                            <option value="price_asc" selected="@(sortBy == "price_asc" ? "selected" : null)">Giá tăng dần</option>
                            <option value="price_desc" selected="@(sortBy == "price_desc" ? "selected" : null)">Giá giảm dần</option>
                            <option value="stock_asc" selected="@(sortBy == "stock_asc" ? "selected" : null)">Tồn kho thấp trước</option>
                            <option value="stock_desc" selected="@(sortBy == "stock_desc" ? "selected" : null)">Tồn kho cao trước</option>
                            <option value="featured" selected="@(sortBy == "featured" ? "selected" : null)">Sản phẩm nổi bật</option>
                        </select>
                    </div>

                    <div class="admin-filter-group">
                        <label>Số dòng mỗi trang</label>
                        <select name="pageSize">
                            <option value="10" selected="@(pageSize == 10 ? "selected" : null)">10 dòng / trang</option>
                            <option value="25" selected="@(pageSize == 25 ? "selected" : null)">25 dòng / trang</option>
                            <option value="50" selected="@(pageSize == 50 ? "selected" : null)">50 dòng / trang</option>
                        </select>
                    </div>

                    <div class="admin-filter-actions">
                        <button type="submit" class="admin-filter-submit">
                            Áp dụng bộ lọc
                        </button>

                        <a asp-area="Admin"
                           asp-controller="Product"
                           asp-action="Index"
                           class="admin-filter-reset">
                            Đặt lại
                        </a>
                    </div>
                </form>
            </aside>

            <section class="admin-product-table-section">
                <div class="admin-product-table-wrap">
                    <table class="admin-product-table">
                        <thead>
                            <tr>
                                <th style="width: 48px;">
                                    <input type="checkbox" id="selectAllProducts" />
                                </th>

                                <th style="width: 72px;"></th>

                                <th>Tên sản phẩm</th>

                                <th style="width: 120px;">Mã SP</th>

                                <th style="width: 140px;">Giá</th>

                                <th style="width: 140px;">Thời gian giao</th>

                                <th style="width: 110px;">Tồn kho</th>

                                <th style="width: 160px;">Ngày tạo</th>

                                <th style="width: 110px;">Hiển thị</th>

                                <th style="width: 70px;"></th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    @* ===== LƯU Ý: PHÂN BIỆT TRẠNG THÁI THỦ CÔNG VÀ THỜI GIAN BÁN ===== *@
                                    var isManuallyHidden = !item.IsActive;

                                    var isNotStarted =
                                        item.IsActive &&
                                        item.AvailableStartDate.HasValue &&
                                        item.AvailableStartDate.Value > now;

                                    var isEnded =
                                        item.IsActive &&
                                        item.AvailableEndDate.HasValue &&
                                        item.AvailableEndDate.Value <= now;

                                    var isVisibleNow =
                                        item.IsActive &&
                                        !isNotStarted &&
                                        !isEnded;
                                    @* ===== KẾT THÚC PHÂN BIỆT TRẠNG THÁI ===== *@

                                    <tr>
                                        <td>
                                            <input type="checkbox"
                                                   class="product-row-checkbox"
                                                   value="@item.Id" />
                                        </td>

                                        <td>
                                            <img src="@item.ImageUrl"
                                                 onerror="this.src='/images/products/no-image.jpg'"
                                                 class="admin-product-thumb"
                                                 alt="@item.Name" />
                                        </td>

                                        <td>
                                            <a asp-area="Admin"
                                               asp-controller="Product"
                                               asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="admin-product-name">
                                                @item.Name
                                            </a>

                                            <div class="admin-product-category">
                                                @(item.Category?.Name ?? "Chưa có danh mục")
                                            </div>
                                        </td>

                                        <td>
                                            <span class="admin-product-code-badge">
                                                @(string.IsNullOrWhiteSpace(item.ProductCode) ? $"P-{item.Id:0000}" : item.ProductCode)
                                            </span>
                                        </td>

                                        <td>
                                            <strong>@item.Price.ToString("N0") đ</strong>
                                        </td>

                                        <td>
                                            <span class="admin-muted-text normal-text">
                                                @(string.IsNullOrWhiteSpace(item.DeliveryTime) ? "Chưa thiết lập" : item.DeliveryTime)
                                            </span>
                                        </td>

                                        <td>
                                            <span class="admin-order-number">
                                                @item.StockQuantity.ToString("N0")
                                            </span>
                                        </td>

                                        <td>
                                            <span class="admin-date-text">
                                                @item.CreatedAt.ToString("dd/MM/yyyy")
                                            </span>

                                            <small>
                                                @item.CreatedAt.ToString("HH:mm")
                                            </small>
                                        </td>

                                        <td class="text-center">
                                            @if (isManuallyHidden)
                                            {
                                                <span class="admin-product-status is-off">
                                                    Đã ẩn thủ công
                                                </span>
                                            }
                                            else if (isNotStarted)
                                            {
                                                <span class="admin-product-status is-off">
                                                    Chưa tới giờ bán
                                                </span>
                                            }
                                            else if (isEnded)
                                            {
                                                <span class="admin-product-status is-off">
                                                    Đã ngừng bán
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="admin-product-status is-on">
                                                    Hiển thị
                                                </span>
                                            }
                                        </td>

                                        <td class="text-end">
                                            <div class="dropdown">
                                                <button type="button"
                                                        class="admin-more-btn"
                                                        data-bs-toggle="dropdown"
                                                        aria-expanded="false"
                                                        title="Thao tác">
                                                    <span class="admin-css-icon admin-icon-more"></span>
                                                </button>

                                                <ul class="dropdown-menu dropdown-menu-end admin-row-menu">
                                                    <li>
                                                        <a class="dropdown-item"
                                                           asp-area="Admin"
                                                           asp-controller="Product"
                                                           asp-action="Edit"
                                                           asp-route-id="@item.Id">
                                                            Sửa sản phẩm
                                                        </a>
                                                    </li>

                                                    <li>
                                                        <form asp-area="Admin"
                                                              asp-controller="Product"
                                                              asp-action="ToggleActive"
                                                              asp-route-id="@item.Id"
                                                              method="post">
                                                            @Html.AntiForgeryToken()

                                                            <button type="submit" class="dropdown-item">
                                                                @(item.IsActive ? "Ẩn sản phẩm" : "Hiện sản phẩm")
                                                            </button>
                                                        </form>
                                                    </li>

                                                    <li>
                                                        <hr class="dropdown-divider" />
                                                    </li>

                                                    <li>
                                                        <button type="button"
                                                                class="dropdown-item text-danger btn-open-delete-modal"
                                                                data-id="@item.Id"
                                                                data-name="@item.Name"
                                                                data-image="@item.ImageUrl">
                                                            Xóa sản phẩm
                                                        </button>
                                                    </li>
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="10" class="admin-empty-row">
                                        Không tìm thấy sản phẩm nào.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="admin-product-footer">
                    <div class="admin-pagination">
                        <a class="admin-page-btn"
                           asp-area="Admin"
                           asp-controller="Product"
                           asp-action="Index"
                           title="Tải lại">
                            <span class="admin-css-icon admin-icon-refresh"></span>
                        </a>

                        <a class="admin-page-btn @(currentPage <= 1 ? "disabled" : "")"
                           asp-area="Admin"
                           asp-controller="Product"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-categoryId="@categoryId"
                           asp-route-minPrice="@minPrice"
                           asp-route-maxPrice="@maxPrice"
                           asp-route-published="@ViewBag.Published"
                           asp-route-sortBy="@sortBy"
                           asp-route-pageSize="@pageSize"
                           asp-route-filterOpen="@filterOpen"
                           asp-route-page="1">
                            «
                        </a>

                        <a class="admin-page-btn @(currentPage <= 1 ? "disabled" : "")"
                           asp-area="Admin"
                           asp-controller="Product"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-categoryId="@categoryId"
                           asp-route-minPrice="@minPrice"
                           asp-route-maxPrice="@maxPrice"
                           asp-route-published="@ViewBag.Published"
                           asp-route-sortBy="@sortBy"
                           asp-route-pageSize="@pageSize"
                           asp-route-filterOpen="@filterOpen"
                           asp-route-page="@(currentPage - 1)">
                            ‹
                        </a>

                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <a class="admin-page-btn @(i == currentPage ? "active" : "")"
                               asp-area="Admin"
                               asp-controller="Product"
                               asp-action="Index"
                               asp-route-search="@search"
                               asp-route-categoryId="@categoryId"
                               asp-route-minPrice="@minPrice"
                               asp-route-maxPrice="@maxPrice"
                               asp-route-published="@ViewBag.Published"
                               asp-route-sortBy="@sortBy"
                               asp-route-pageSize="@pageSize"
                               asp-route-filterOpen="@filterOpen"
                               asp-route-page="@i">
                                @i
                            </a>
                        }

                        <a class="admin-page-btn @(currentPage >= totalPages ? "disabled" : "")"
                           asp-area="Admin"
                           asp-controller="Product"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-categoryId="@categoryId"
                           asp-route-minPrice="@minPrice"
                           asp-route-maxPrice="@maxPrice"
                           asp-route-published="@ViewBag.Published"
                           asp-route-sortBy="@sortBy"
                           asp-route-pageSize="@pageSize"
                           asp-route-filterOpen="@filterOpen"
                           asp-route-page="@(currentPage + 1)">
                            ›
                        </a>

                        <a class="admin-page-btn @(currentPage >= totalPages ? "disabled" : "")"
                           asp-area="Admin"
                           asp-controller="Product"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-categoryId="@categoryId"
                           asp-route-minPrice="@minPrice"
                           asp-route-maxPrice="@maxPrice"
                           asp-route-published="@ViewBag.Published"
                           asp-route-sortBy="@sortBy"
                           asp-route-pageSize="@pageSize"
                           asp-route-filterOpen="@filterOpen"
                           asp-route-page="@totalPages">
                            »
                        </a>
                    </div>

                    <div class="admin-footer-info">
                        <span>
                            Đang hiển thị trang @currentPage / @totalPages — tổng @totalItems sản phẩm
                        </span>

                        <form asp-area="Admin"
                              asp-controller="Product"
                              asp-action="Index"
                              method="get"
                              class="admin-page-size-form">

                            <input type="hidden" name="search" value="@search" />
                            <input type="hidden" name="categoryId" value="@categoryId" />
                            <input type="hidden" name="minPrice" value="@minPrice" />
                            <input type="hidden" name="maxPrice" value="@maxPrice" />
                            <input type="hidden" name="published" value="@ViewBag.Published" />
                            <input type="hidden" name="sortBy" value="@sortBy" />
                            <input type="hidden" name="filterOpen" value="@filterOpen" />

                            <select name="pageSize" onchange="this.form.submit()" class="admin-page-size">
                                <option value="10" selected="@(pageSize == 10 ? "selected" : null)">10 dòng / trang</option>
                                <option value="25" selected="@(pageSize == 25 ? "selected" : null)">25 dòng / trang</option>
                                <option value="50" selected="@(pageSize == 50 ? "selected" : null)">50 dòng / trang</option>
                            </select>
                        </form>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

<style>
    .product-delete-overlay {
        position: fixed;
        inset: 0;
        z-index: 99999;
        display: none;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.45);
        padding: 20px;
    }

        .product-delete-overlay.show {
            display: flex;
        }

    .product-delete-modal {
        position: relative;
        width: 560px;
        max-width: 100%;
        background: #ffffff;
        border-radius: 6px;
        padding: 30px 32px 26px;
        box-shadow: 0 14px 45px rgba(0, 0, 0, 0.25);
    }

        .product-delete-modal h2 {
            margin: 0 0 22px;
            font-size: 24px;
            font-weight: 600;
            color: #333;
        }

        .product-delete-modal p {
            margin: 0 0 20px;
            font-size: 16px;
            color: #555;
        }

    .product-delete-close {
        position: absolute;
        top: 14px;
        right: 18px;
        width: 36px;
        height: 36px;
        border: none;
        background: transparent;
        font-size: 30px;
        line-height: 30px;
        color: #999;
        cursor: pointer;
    }

        .product-delete-close:hover {
            color: #333;
        }

    .product-delete-info {
        display: flex;
        align-items: center;
        gap: 18px;
        min-height: 90px;
        margin-bottom: 30px;
    }

        .product-delete-info img {
            width: 82px;
            height: 82px;
            object-fit: cover;
            border: 1px solid #e5e5e5;
            border-radius: 4px;
            background: #fff;
        }

        .product-delete-info strong {
            display: block;
            font-size: 17px;
            font-weight: 600;
            color: #222;
            line-height: 1.4;
        }

    .product-delete-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 12px;
    }

        .product-delete-actions form {
            margin: 0;
        }

    .product-delete-cancel {
        min-width: 90px;
        height: 44px;
        padding: 0 18px;
        border: none;
        background: transparent;
        font-size: 16px;
        color: #777;
        cursor: pointer;
    }

        .product-delete-cancel:hover {
            color: #333;
            background: #f5f5f5;
        }

    .product-delete-confirm {
        min-width: 120px;
        height: 44px;
        padding: 0 20px;
        border: none;
        border-radius: 3px;
        background: #ee4d2d;
        color: #fff;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
    }

        .product-delete-confirm:hover {
            background: #d94325;
        }

    @@media (max-width: 600px) {
        .product-delete-modal {
            padding: 24px 20px;
        }

        .product-delete-info img {
            width: 70px;
            height: 70px;
        }

        .product-delete-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .product-delete-cancel,
        .product-delete-confirm {
            width: 100%;
        }
    }
    /* ===== LƯU Ý: TRẠNG THÁI NÚT XÓA MỤC ĐÃ CHỌN ===== */
    .admin-delete-selected-btn:disabled {
        color: #95a3b7;
        cursor: not-allowed;
        opacity: 0.65;
    }

    .admin-delete-selected-btn:not(:disabled) {
        color: #dc2626;
        cursor: pointer;
        opacity: 1;
    }

        .admin-delete-selected-btn:not(:disabled):hover {
            background: #fff1f2;
            color: #b91c1c;
        }
</style>
<div id="deleteProductModal" class="product-delete-overlay">
    <div class="product-delete-modal">

        <button type="button"
                id="closeDeleteModal"
                class="product-delete-close">
            ×
        </button>

        <h2 id="deleteModalTitle">Xóa sản phẩm</h2>

        <p id="deleteProductQuestion">
            Bạn có chắc muốn xóa sản phẩm sau?
        </p>

        <div class="product-delete-info" id="deleteProductInfo">
            <img id="deleteProductImage"
                 src=""
                 alt="Sản phẩm" />

            <div>
                <strong id="deleteProductName"></strong>
            </div>
        </div>

        <div class="product-delete-actions">

            <button type="button"
                    id="cancelDeleteModal"
                    class="product-delete-cancel">
                Hủy
            </button>

            @* ===== LƯU Ý: NÚT XÁC NHẬN DÙNG CHUNG CHO XÓA MỘT VÀ XÓA NHIỀU ===== *@
            <button type="button"
                    id="confirmDeleteModal"
                    class="product-delete-confirm">
                Xóa sản phẩm
            </button>
            @* ===== KẾT THÚC NÚT XÁC NHẬN ===== *@

        </div>
    </div>
</div>


@* ===== LƯU Ý: FORM XÓA MỘT SẢN PHẨM ===== *@
<form id="singleDeleteProductForm"
      asp-area="Admin"
      asp-controller="Product"
      asp-action="Delete"
      method="post"
      style="display:none;">
    @Html.AntiForgeryToken()

    <input type="hidden"
           name="id"
           id="singleDeleteProductId" />
</form>
@* ===== KẾT THÚC FORM XÓA MỘT SẢN PHẨM ===== *@


@* ===== LƯU Ý: FORM XÓA NHIỀU SẢN PHẨM ===== *@
<form id="deleteSelectedProductsForm"
      asp-area="Admin"
      asp-controller="Product"
      asp-action="DeleteSelected"
      method="post"
      style="display:none;">
    @Html.AntiForgeryToken()

    <div id="deleteSelectedProductInputs"></div>
</form>
@* ===== KẾT THÚC FORM XÓA NHIỀU SẢN PHẨM ===== *@
@* ===== LƯU Ý: FORM XÓA CÁC SẢN PHẨM ĐƯỢC CHỌN ===== *@
<form id="deleteSelectedProductsForm"
      asp-area="Admin"
      asp-controller="Product"
      asp-action="DeleteSelected"
      method="post"
      style="display:none;">
    @Html.AntiForgeryToken()

    <div id="deleteSelectedProductInputs"></div>
</form>
@* ===== KẾT THÚC FORM XÓA CÁC SẢN PHẨM ĐƯỢC CHỌN ===== *@
@* ===== LƯU Ý: FORM XÓA MỘT SẢN PHẨM ===== *@
<form id="singleDeleteProductForm"
      asp-area="Admin"
      asp-controller="Product"
      asp-action="Delete"
      method="post"
      style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="singleDeleteProductId" />
</form>
@* ===== KẾT THÚC FORM XÓA MỘT SẢN PHẨM ===== *@


@* ===== LƯU Ý: FORM XÓA NHIỀU SẢN PHẨM ===== *@
<form id="deleteSelectedProductsForm"
      asp-area="Admin"
      asp-controller="Product"
      asp-action="DeleteSelected"
      method="post"
      style="display:none;">
    @Html.AntiForgeryToken()
    <div id="deleteSelectedProductInputs"></div>
</form>
@* ===== KẾT THÚC FORM XÓA NHIỀU SẢN PHẨM ===== *@


@* ===== LƯU Ý: MODAL XÁC NHẬN DÙNG CHUNG CHO XÓA MỘT VÀ XÓA NHIỀU ===== *@
<div class="modal fade"
     id="deleteProductsConfirmModal"
     tabindex="-1"
     aria-labelledby="deleteProductsConfirmModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content"
             style="border:none;
            border-radius:18px;
            overflow:hidden;
            box-shadow:0 24px 60px rgba(15,23,42,.25);">

            <div style="padding:24px 26px;
                background:linear-gradient(135deg,#ef4444,#dc2626);
                color:white;
                display:flex;
                align-items:center;
                gap:14px;">

                <div style="width:46px;
                    height:46px;
                    border-radius:50%;
                    background:rgba(255,255,255,.18);
                    display:flex;
                    align-items:center;
                    justify-content:center;
                    font-size:22px;">
                    !
                </div>

                <div>
                    <h5 id="deleteProductsConfirmModalLabel"
                        style="margin:0;
                        font-size:20px;
                        font-weight:900;">
                        Xác nhận xóa
                    </h5>

                    <div style="margin-top:3px;
                        opacity:.9;
                        font-size:13px;">
                        Thao tác này cần được xác nhận
                    </div>
                </div>
            </div>

            <div style="padding:26px;">
                <p id="deleteProductsConfirmMessage"
                   style="margin:0;
                    color:#334155;
                    font-size:15px;
                    line-height:1.6;">
                    Bạn có chắc muốn xóa sản phẩm này không?
                </p>
            </div>

            <div style="padding:0 26px 24px;
                display:flex;
                justify-content:flex-end;
                gap:12px;">

                <button type="button"
                        class="btn btn-light"
                        data-bs-dismiss="modal"
                        style="min-width:110px;
                    height:44px;
                    border-radius:10px;
                    font-weight:800;">
                    Hủy
                </button>

                <button type="button"
                        id="confirmDeleteProductsBtn"
                        class="btn btn-danger"
                        style="min-width:120px;
                    height:44px;
                    border-radius:10px;
                    font-weight:850;">
                    Xóa
                </button>
            </div>
        </div>
    </div>
</div>
@* ===== KẾT THÚC MODAL XÁC NHẬN ===== *@
@section Scripts {
    <script>
        const productFilterButton =
            document.getElementById("toggleProductFilter");

        const productManager =
            document.getElementById("adminProductManager");

        if (productFilterButton && productManager) {
            productFilterButton.addEventListener("click", function() {
                productManager.classList.toggle("filter-open");
                productFilterButton.classList.toggle("active");
            });
        }


        // ===== LƯU Ý: XỬ LÝ CHỌN NHIỀU SẢN PHẨM =====
        const selectAllProducts =
            document.getElementById("selectAllProducts");

        const productCheckboxes =
            Array.from(
                document.querySelectorAll(".product-row-checkbox")
            );

        const deleteSelectedProductsBtn =
            document.getElementById("deleteSelectedProductsBtn");

        function getSelectedProducts() {
            return productCheckboxes.filter(function(checkbox) {
                return checkbox.checked;
            });
        }

        function updateSelectedState() {
            const selectedCount = getSelectedProducts().length;

            if (deleteSelectedProductsBtn) {
                deleteSelectedProductsBtn.disabled =
                    selectedCount === 0;

                deleteSelectedProductsBtn.title =
                    selectedCount === 0
                        ? "Hãy chọn ít nhất một sản phẩm"
                        : `Xóa ${selectedCount} sản phẩm đã chọn`;
            }

            if (selectAllProducts) {
                selectAllProducts.checked =
                    productCheckboxes.length > 0 &&
                    selectedCount === productCheckboxes.length;

                selectAllProducts.indeterminate =
                    selectedCount > 0 &&
                    selectedCount < productCheckboxes.length;
            }
        }

        if (selectAllProducts) {
            selectAllProducts.addEventListener("change", function() {
                productCheckboxes.forEach(function(checkbox) {
                    checkbox.checked = selectAllProducts.checked;
                });

                updateSelectedState();
            });
        }

        productCheckboxes.forEach(function(checkbox) {
            checkbox.addEventListener(
                "change",
                updateSelectedState
            );
        });
        // ===== KẾT THÚC XỬ LÝ CHỌN NHIỀU =====


        // ===== LƯU Ý: MODAL XÓA DÙNG CHUNG =====
        const deleteModal =
            document.getElementById("deleteProductModal");

        const closeDeleteModalButton =
            document.getElementById("closeDeleteModal");

        const cancelDeleteModalButton =
            document.getElementById("cancelDeleteModal");

        const confirmDeleteModalButton =
            document.getElementById("confirmDeleteModal");

        const deleteModalTitle =
            document.getElementById("deleteModalTitle");

        const deleteProductQuestion =
            document.getElementById("deleteProductQuestion");

        const deleteProductInfo =
            document.getElementById("deleteProductInfo");

        const deleteProductImage =
            document.getElementById("deleteProductImage");

        const deleteProductName =
            document.getElementById("deleteProductName");

        const singleDeleteProductForm =
            document.getElementById("singleDeleteProductForm");

        const singleDeleteProductId =
            document.getElementById("singleDeleteProductId");

        const deleteSelectedProductsForm =
            document.getElementById("deleteSelectedProductsForm");

        const deleteSelectedProductInputs =
            document.getElementById("deleteSelectedProductInputs");

        let deleteMode = null;


        function openDeleteModal() {
            if (!deleteModal) {
                return;
            }

            confirmDeleteModalButton.disabled = false;

            deleteModal.classList.add("show");
            document.body.style.overflow = "hidden";
        }


        function closeDeleteModal() {
            if (!deleteModal) {
                return;
            }

            deleteModal.classList.remove("show");
            document.body.style.overflow = "";

            deleteMode = null;

            confirmDeleteModalButton.disabled = false;

            deleteProductImage.style.display = "";
            deleteProductInfo.style.display = "flex";

            deleteModalTitle.textContent = "Xóa sản phẩm";
            confirmDeleteModalButton.textContent = "Xóa sản phẩm";
        }


        // ===== LƯU Ý: XÓA MỘT SẢN PHẨM TỪ DẤU BA CHẤM =====
        document
            .querySelectorAll(".btn-open-delete-modal")
            .forEach(function(button) {

                button.addEventListener("click", function() {
                    deleteMode = "single";

                    const productId =
                        button.dataset.id;

                    const productName =
                        button.dataset.name || "Sản phẩm";

                    const productImage =
                        button.dataset.image ||
                        "/images/products/no-image.jpg";

                    singleDeleteProductId.value =
                        productId;

                    deleteModalTitle.textContent =
                        "Xóa sản phẩm";

                    deleteProductQuestion.textContent =
                        "Bạn có chắc muốn xóa sản phẩm sau?";

                    deleteProductInfo.style.display =
                        "flex";

                    deleteProductImage.style.display =
                        "";

                    deleteProductImage.src =
                        productImage;

                    deleteProductName.textContent =
                        productName;

                    confirmDeleteModalButton.textContent =
                        "Xóa sản phẩm";

                    openDeleteModal();
                });
            });
        // ===== KẾT THÚC XÓA MỘT SẢN PHẨM =====


        // ===== LƯU Ý: XÓA CÁC MỤC ĐÃ CHỌN BẰNG CÙNG TEMPLATE =====
        if (deleteSelectedProductsBtn) {
            deleteSelectedProductsBtn.addEventListener(
                "click",
                function() {

                    const selectedProducts =
                        getSelectedProducts();

                    if (selectedProducts.length === 0) {
                        return;
                    }

                    deleteMode = "multiple";

                    deleteSelectedProductInputs.innerHTML =
                        "";

                    selectedProducts.forEach(
                        function(checkbox) {

                            const input =
                                document.createElement("input");

                            input.type = "hidden";
                            input.name = "selectedIds";
                            input.value = checkbox.value;

                            deleteSelectedProductInputs
                                .appendChild(input);
                        }
                    );

                    deleteModalTitle.textContent =
                        "Xóa các sản phẩm đã chọn";

                    deleteProductQuestion.textContent =
                        "Bạn có chắc muốn xóa các sản phẩm sau?";

                    deleteProductInfo.style.display =
                        "flex";

                    deleteProductImage.style.display =
                        "none";

                    deleteProductName.textContent =
                        `${selectedProducts.length} sản phẩm đã chọn`;

                    confirmDeleteModalButton.textContent =
                        "Xóa mục đã chọn";

                    openDeleteModal();
                }
            );
        }
        // ===== KẾT THÚC XÓA CÁC MỤC ĐÃ CHỌN =====


        // ===== LƯU Ý: NÚT XÁC NHẬN XÓA =====
        if (confirmDeleteModalButton) {
            confirmDeleteModalButton.addEventListener(
                "click",
                function() {

                    confirmDeleteModalButton.disabled =
                        true;

                    if (deleteMode === "single") {
                        singleDeleteProductForm.submit();
                        return;
                    }

                    if (deleteMode === "multiple") {
                        deleteSelectedProductsForm.submit();
                        return;
                    }

                    confirmDeleteModalButton.disabled =
                        false;
                }
            );
        }
        // ===== KẾT THÚC NÚT XÁC NHẬN =====


        if (closeDeleteModalButton) {
            closeDeleteModalButton.addEventListener(
                "click",
                closeDeleteModal
            );
        }

        if (cancelDeleteModalButton) {
            cancelDeleteModalButton.addEventListener(
                "click",
                closeDeleteModal
            );
        }

        if (deleteModal) {
            deleteModal.addEventListener(
                "click",
                function(event) {

                    if (event.target === deleteModal) {
                        closeDeleteModal();
                    }
                }
            );
        }

        document.addEventListener(
            "keydown",
            function(event) {

                if (event.key === "Escape" &&
                    deleteModal &&
                    deleteModal.classList.contains("show")) {

                    closeDeleteModal();
                }
            }
        );
        // ===== KẾT THÚC MODAL XÓA DÙNG CHUNG =====


        updateSelectedState();
    </script>
}
@model MiniSmartstoreMvc.ViewModels.ShopDrawerViewModel

@{
    var now = DateTime.Now;

    var cartItems = Model.CartItems
        .Where(x => x.Product != null)
        .ToList();

    // ===== LƯU Ý: CHỈ TÍNH SẢN PHẨM CÒN KHẢ DỤNG VÀO TỔNG TIỀN =====
    var availableCartItems = cartItems
        .Where(x =>
            x.Product != null &&
            x.Product.IsActive &&
            x.Product.StockQuantity > 0 &&
            x.Quantity <= x.Product.StockQuantity &&
            (!x.Product.AvailableStartDate.HasValue ||
             x.Product.AvailableStartDate.Value <= now) &&
            (!x.Product.AvailableEndDate.HasValue ||
             x.Product.AvailableEndDate.Value > now))
        .ToList();

    var cartTotal = availableCartItems
        .Sum(x => x.Product!.Price * x.Quantity);

    var hasUnavailableCartItems =
        cartItems.Count != availableCartItems.Count;
    // ===== KẾT THÚC TÍNH SẢN PHẨM CÒN KHẢ DỤNG =====

    // ===== LƯU Ý: BADGE GIỎ HÀNG VẪN TÍNH CÁC SẢN PHẨM THỰC SỰ CÒN TRONG GIỎ =====
    var cartCount = cartItems.Sum(x => x.Quantity);
    // ===== KẾT THÚC BADGE GIỎ HÀNG =====

    var wishlistCount = Model.WishlistProducts.Count;
    var compareCount = Model.CompareProducts.Count;

    var activeTab = Model.ActiveTab?.ToLower() ?? "cart";
    var drawerMessage = ViewBag.DrawerMessage as string;
}

<form id="drawerAntiForgeryForm" style="display:none">
    @Html.AntiForgeryToken()
</form>

<div class="shop-drawer-overlay" data-drawer-close></div>

<aside class="shop-drawer-panel">
    <div class="shop-drawer-header">
        <div class="shop-drawer-tabs">
            <button type="button"
                    class="shop-drawer-tab @(activeTab == "cart" ? "active" : "")"
                    data-drawer-tab="cart">
                Giỏ hàng
                <span>@cartCount</span>
            </button>

            <button type="button"
                    class="shop-drawer-tab @(activeTab == "wishlist" ? "active" : "")"
                    data-drawer-tab="wishlist">
                Yêu thích
                <span>@wishlistCount</span>
            </button>

            <button type="button"
                    class="shop-drawer-tab @(activeTab == "compare" ? "active" : "")"
                    data-drawer-tab="compare">
                So sánh
                <span>@compareCount</span>
            </button>
        </div>

        <button type="button"
                class="shop-drawer-close js-shop-drawer-close"
                data-drawer-close>
            ×
        </button>
    </div>


    <div class="shop-drawer-body">

        @* ==================== GIỎ HÀNG ==================== *@
        @* ==================== GIỎ HÀNG ==================== *@
        @if (activeTab == "cart")
        {
            if (cartItems.Any())
            {
                foreach (var item in cartItems)
                {
                    var product = item.Product!;

                    @* ===== LƯU Ý: XÁC ĐỊNH TRẠNG THÁI SẢN PHẨM TRONG GIỎ ===== *@
                    var isStoppedSelling =
                        !product.IsActive ||
                        (product.AvailableStartDate.HasValue &&
                         product.AvailableStartDate.Value > now) ||
                        (product.AvailableEndDate.HasValue &&
                         product.AvailableEndDate.Value <= now);

                    var isOutOfStock =
                        !isStoppedSelling &&
                        product.StockQuantity <= 0;

                    var isInsufficientStock =
                        !isStoppedSelling &&
                        product.StockQuantity > 0 &&
                        item.Quantity > product.StockQuantity;

                    var isAvailable =
                        !isStoppedSelling &&
                        !isOutOfStock &&
                        !isInsufficientStock;
                    @* ===== KẾT THÚC XÁC ĐỊNH TRẠNG THÁI ===== *@

                    <div class="drawer-product-card"
                         style="display:grid !important;">

                        <div class="drawer-product-image">
                            <img src="@product.ImageUrl"
                                 alt="@product.Name"
                                 onerror="this.src='/images/products/no-image.jpg'" />
                        </div>

                        <div class="drawer-product-content">
                            <div class="drawer-product-top">
                                <div>
                                    <h4>@product.Name</h4>
                                    <p>@product.Category?.Name</p>
                                </div>

                                @if (isAvailable)
                                {
                                    <strong>
                                        @((product.Price * item.Quantity).ToString("N0")) đ
                                    </strong>
                                }
                                else
                                {
                                    <strong style="color:#e11d48;">
                                        Không tính
                                    </strong>
                                }
                            </div>

                            <div class="drawer-product-meta">
                                <div>
                                    Đơn giá: @product.Price.ToString("N0") đ
                                </div>

                                @if (isStoppedSelling)
                                {
                                    @* ===== LƯU Ý: HIỂN THỊ NGAY TRÊN SẢN PHẨM ĐÃ NGỪNG BÁN ===== *@
                                    <span style="
                                        display:inline-flex;
                                        margin-top:7px;
                                        padding:4px 9px;
                                        border-radius:7px;
                                        background:#dc3545;
                                        color:#fff;
                                        font-size:12px;
                                        font-weight:800;">
                                        Đã ngừng bán
                                    </span>
                                    @* ===== KẾT THÚC TRẠNG THÁI NGỪNG BÁN ===== *@
                                }
                                else if (isOutOfStock)
                                {
                                    <span style="
                                        display:inline-flex;
                                        margin-top:7px;
                                        padding:4px 9px;
                                        border-radius:7px;
                                        background:#f59e0b;
                                        color:#fff;
                                        font-size:12px;
                                        font-weight:800;">
                                        Hết hàng
                                    </span>
                                }
                                else if (isInsufficientStock)
                                {
                                    <span style="
                                        display:inline-flex;
                                        margin-top:7px;
                                        padding:4px 9px;
                                        border-radius:7px;
                                        background:#f59e0b;
                                        color:#fff;
                                        font-size:12px;
                                        font-weight:800;">
                                        Không đủ tồn kho
                                    </span>
                                }
                            </div>

                            <div class="drawer-product-actions">
                                @if (isAvailable)
                                {
                                    <div class="drawer-qty-control">
                                        <button type="button"
                                                class="js-cart-qty"
                                                data-product-id="@product.Id"
                                                data-quantity="@(item.Quantity - 1)">
                                            −
                                        </button>

                                        <span>@item.Quantity</span>

                                        <button type="button"
                                                class="js-cart-qty"
                                                data-product-id="@product.Id"
                                                data-quantity="@(item.Quantity + 1)">
                                            +
                                        </button>
                                    </div>

                                    <button type="button"
                                            class="drawer-icon-btn js-add-wishlist"
                                            data-product-id="@product.Id"
                                            title="Thêm vào yêu thích">
                                        ♡
                                    </button>
                                }
                                else
                                {
                                    <div style="
                                        font-size:13px;
                                        color:#64748b;
                                        line-height:1.4;">
                                        <strong>Số lượng: @item.Quantity</strong>
                                        <div>Không thể thay đổi</div>
                                    </div>
                                }

                                <button type="button"
                                        class="drawer-icon-btn danger js-cart-remove"
                                        data-product-id="@product.Id"
                                        title="Xóa khỏi giỏ hàng">
                                    🗑
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="drawer-empty-state">
                    <div class="drawer-empty-icon">🛒</div>

                    <h3>Giỏ hàng trống</h3>

                    <p>
                        Bạn chưa thêm sản phẩm nào vào giỏ hàng.
                    </p>

                    <a asp-controller="Product"
                       asp-action="Index">
                        Tiếp tục mua sắm
                    </a>
                </div>
            }
        }
        @if (activeTab == "wishlist")
        {
            if (Model.WishlistProducts.Any())
            {
                foreach (var item in Model.WishlistProducts)
                {
                    <div class="drawer-product-card">
                        <div class="drawer-product-image">
                            <img src="@item.ImageUrl"
                                 alt="@item.Name"
                                 onerror="this.src='/images/products/no-image.jpg'" />
                        </div>

                        <div class="drawer-product-content">
                            <div class="drawer-product-top">
                                <div>
                                    <h4>@item.Name</h4>
                                    <p>@item.Category?.Name</p>
                                </div>

                                <strong>
                                    @item.Price.ToString("N0") đ
                                </strong>
                            </div>

                            <div class="drawer-product-actions">
                                <button type="button"
                                        class="drawer-main-small-btn js-drawer-add-cart"
                                        data-product-id="@item.Id">
                                    🛒 Thêm giỏ
                                </button>

                                <button type="button"
                                        class="drawer-icon-btn danger js-drawer-remove js-remove-wishlist"
                                        data-url="/ShopDrawer/RemoveWishlist"
                                        data-id="@item.Id"
                                        data-product-id="@item.Id"
                                        data-tab="wishlist"
                                        title="Xóa khỏi yêu thích">
                                    🗑
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="drawer-empty-state">
                    <div class="drawer-empty-icon">♡</div>
                    <h3>Danh sách yêu thích trống</h3>
                    <p>Bạn chưa thêm sản phẩm nào vào yêu thích.</p>

                    <a asp-controller="Product"
                       asp-action="Index">
                        Xem sản phẩm
                    </a>
                </div>
            }
        }

        @* ==================== SO SÁNH ==================== *@
        @if (activeTab == "compare")
        {
            if (Model.CompareProducts.Any())
            {
                foreach (var item in Model.CompareProducts)
                {
                    <div class="drawer-product-card">
                        <div class="drawer-product-image">
                            <img src="@item.ImageUrl"
                                 alt="@item.Name"
                                 onerror="this.src='/images/products/no-image.jpg'" />
                        </div>

                        <div class="drawer-product-content">
                            <div class="drawer-product-top">
                                <div>
                                    <h4>@item.Name</h4>
                                    <p>@item.Category?.Name</p>
                                </div>

                                <strong>
                                    @item.Price.ToString("N0") đ
                                </strong>
                            </div>

                            <div class="drawer-product-actions">
                                <button type="button"
                                        class="drawer-main-small-btn js-drawer-add-cart"
                                        data-product-id="@item.Id">
                                    🛒 Thêm giỏ
                                </button>

                                <button type="button"
                                        class="drawer-icon-btn danger js-drawer-remove js-remove-compare"
                                        data-url="/ShopDrawer/RemoveCompare"
                                        data-id="@item.Id"
                                        data-product-id="@item.Id"
                                        data-tab="compare"
                                        title="Xóa khỏi so sánh">
                                    🗑
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="drawer-empty-state">
                    <div class="drawer-empty-icon">⇄</div>
                    <h3>Danh sách so sánh trống</h3>
                    <p>Bạn chưa thêm sản phẩm nào để so sánh.</p>

                    <a asp-controller="Product"
                       asp-action="Index">
                        Xem sản phẩm
                    </a>
                </div>
            }
        }
    </div>

    <div class="shop-drawer-footer @(activeTab == "cart" ? "cart-footer" : activeTab == "wishlist" ? "wishlist-footer" : "compare-footer")">

        @* ==================== FOOTER GIỎ HÀNG ==================== *@
        @* ==================== FOOTER GIỎ HÀNG ==================== *@
        @if (activeTab == "cart")
        {
            <div class="drawer-total-row">
                <span>Tổng tiền:</span>
                <strong>@cartTotal.ToString("N0") đ</strong>
            </div>

            <div class="drawer-footer-actions drawer-cart-actions">
                <a asp-controller="Cart"
                   asp-action="Index"
                   class="drawer-action-btn">
                    Xem giỏ hàng
                </a>

                @if (availableCartItems.Any())
                {
                    <a asp-controller="Checkout"
                       asp-action="Index"
                       class="drawer-checkout-btn">
                        Thanh toán
                    </a>
                }
                else
                {
                    <button type="button"
                            class="drawer-checkout-btn"
                            disabled
                            style="opacity:.55; cursor:not-allowed;">
                        Không thể thanh toán
                    </button>
                }
            </div>
        }
    </div>
</aside>
@model IEnumerable<MiniSmartstoreMvc.Models.Product>
@using MiniSmartstoreMvc.Models

@{
    ViewData["Title"] = "Sản phẩm";

    var products = Model?.ToList() ?? new List<Product>();
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    var categoryCounts = ViewBag.CategoryCounts as Dictionary<int, int> ?? new Dictionary<int, int>();

    int? currentCategoryId = ViewBag.CategoryId;
    string search = ViewBag.Search as string ?? "";
    string globalSearch = ViewBag.GlobalSearch as string ?? "";
    string sortOrder = ViewBag.SortOrder as string ?? "featured";
    string viewMode = ViewBag.ViewMode as string ?? "grid";
    string priceRange = ViewBag.PriceRange as string ?? "";
    string stockStatus = ViewBag.StockStatus as string ?? "";
    int? minRating = ViewBag.MinRating;
    string deliveryTime = ViewBag.DeliveryTime as string ?? "";

    decimal? minPrice = ViewBag.MinPrice;
    decimal? maxPrice = ViewBag.MaxPrice;

    var selectedCategory = categories.FirstOrDefault(c => c.Id == currentCategoryId);
    var pageTitle = selectedCategory?.Name ?? "Tất cả sản phẩm";
}


<div class="container smart-category-page">

    <div class="smart-category-breadcrumb">

        <a asp-controller="Home"
           asp-action="Index">
            🏠
        </a>

        <span>/</span>

        <span>@pageTitle</span>

    </div>


    <div class="smart-category-shop-frame">

        <aside class="smart-filter-sidebar">

            <!-- DANH MỤC -->
            <div class="smart-filter-card">

                <div class="smart-filter-title">
                    Danh mục sản phẩm
                </div>


                <a asp-controller="Product"
                   asp-action="Index"
                   asp-route-search="@search"
                   asp-route-minPrice="@minPrice"
                   asp-route-maxPrice="@maxPrice"
                   asp-route-priceRange="@priceRange"
                   asp-route-stockStatus="@stockStatus"
                   asp-route-minRating="@minRating"
                   asp-route-deliveryTime="@deliveryTime"
                   asp-route-viewMode="@viewMode"
                   asp-route-sortOrder="@sortOrder"
                   class="smart-category-filter-item @(currentCategoryId == null ? "active" : "")">

                    <span>
                        Tất cả sản phẩm
                    </span>

                    <strong>
                        @categoryCounts.Values.Sum()
                    </strong>

                </a>


                @foreach (var category in categories)
                {
                    var count = categoryCounts.ContainsKey(category.Id)
                        ? categoryCounts[category.Id]
                        : 0;

                    <a asp-controller="Product"
                       asp-action="Index"
                       asp-route-categoryId="@category.Id"
                       asp-route-search="@search"
                       asp-route-minPrice="@minPrice"
                       asp-route-maxPrice="@maxPrice"
                       asp-route-priceRange="@priceRange"
                       asp-route-stockStatus="@stockStatus"
                       asp-route-minRating="@minRating"
                       asp-route-deliveryTime="@deliveryTime"
                       asp-route-viewMode="@viewMode"
                       asp-route-sortOrder="@sortOrder"
                       class="smart-category-filter-item @(currentCategoryId == category.Id ? "active" : "")">

                        <span>
                            @category.Name
                        </span>

                        <strong>
                            @count
                        </strong>

                    </a>
                }

            </div>


            <!-- FORM BỘ LỌC -->
            <form asp-controller="Product"
                  asp-action="Index"
                  method="get"
                  class="smart-filter-card smart-filter-form">

                <input type="hidden"
                       name="categoryId"
                       value="@currentCategoryId" />

                <input type="hidden"
                       name="viewMode"
                       value="@viewMode" />

                <input type="hidden"
                       name="sortOrder"
                       value="@sortOrder" />


                <!-- TÌM KIẾM -->
                <div class="smart-filter-section">

                    <button type="button"
                            class="smart-filter-collapse">
                        Tìm kiếm
                    </button>

                    <input type="text"
                           name="search"
                           value="@search"
                           class="form-control"
                           placeholder="Tìm sản phẩm..." />

                </div>


                <!-- GIÁ -->
                <div class="smart-filter-section smart-price-filter-v2">

                    <button type="button"
                            class="smart-filter-collapse">
                        Giá
                    </button>


                    <label class="smart-filter-radio">

                        <input type="radio"
                               name="priceRange"
                               value=""
                        @(string.IsNullOrWhiteSpace(priceRange) &&
                          !minPrice.HasValue &&
                          !maxPrice.HasValue
                            ? "checked"
                            : "") />

                        <span>
                            Tất cả mức giá
                        </span>

                    </label>


                    <label class="smart-filter-radio">

                        <input type="radio"
                               name="priceRange"
                               value="under_1m"
                        @(priceRange == "under_1m" ? "checked" : "") />

                        <span>
                            Dưới 1 triệu
                        </span>

                    </label>


                    <label class="smart-filter-radio">

                        <input type="radio"
                               name="priceRange"
                               value="1m_5m"
                        @(priceRange == "1m_5m" ? "checked" : "") />

                        <span>
                            1 - 5 triệu
                        </span>

                    </label>


                    <label class="smart-filter-radio">

                        <input type="radio"
                               name="priceRange"
                               value="5m_10m"
                        @(priceRange == "5m_10m" ? "checked" : "") />

                        <span>
                            5 - 10 triệu
                        </span>

                    </label>


                    <label class="smart-filter-radio">

                        <input type="radio"
                               name="priceRange"
                               value="10m_20m"
                        @(priceRange == "10m_20m" ? "checked" : "") />

                        <span>
                            10 - 20 triệu
                        </span>

                    </label>


                    <label class="smart-filter-radio">

                        <input type="radio"
                               name="priceRange"
                               value="over_20m"
                        @(priceRange == "over_20m" ? "checked" : "") />

                        <span>
                            Trên 20 triệu
                        </span>

                    </label>


                    @* ===== LƯU Ý: NHẬP KHOẢNG GIÁ LINH HOẠT ===== *@

                    <div class="smart-price-custom-title">
                        Khoảng giá tùy chọn
                    </div>


                    <div class="smart-price-custom smart-price-custom-v2">

                        <input type="text"
                               id="priceMinDisplay"
                               class="form-control"
                               inputmode="text"
                               autocomplete="off"
                               value="@(string.IsNullOrWhiteSpace(priceRange) && minPrice.HasValue ? minPrice.Value.ToString("0") : "")"
                               placeholder="VD: 500k" />


                        <span class="smart-price-separator">
                            -
                        </span>


                        <input type="text"
                               id="priceMaxDisplay"
                               class="form-control"
                               inputmode="text"
                               autocomplete="off"
                               value="@(string.IsNullOrWhiteSpace(priceRange) && maxPrice.HasValue ? maxPrice.Value.ToString("0") : "")"
                               placeholder="VD: 5tr" />

                    </div>


                    <input type="hidden"
                           id="priceMinValue"
                           name="minPrice"
                           value="@(string.IsNullOrWhiteSpace(priceRange) && minPrice.HasValue ? minPrice.Value.ToString("0") : "")" />


                    <input type="hidden"
                           id="priceMaxValue"
                           name="maxPrice"
                           value="@(string.IsNullOrWhiteSpace(priceRange) && maxPrice.HasValue ? maxPrice.Value.ToString("0") : "")" />


                    <div class="smart-price-help">
                        Có thể nhập: 500k, 2tr, 2.5tr,
                        2000000 hoặc 2.000.000đ
                    </div>


                    <div id="smartPriceError"
                         class="smart-price-error"
                         role="alert"
                         aria-live="polite">
                    </div>

                    @* ===== KẾT THÚC NHẬP KHOẢNG GIÁ LINH HOẠT ===== *@

                </div>


                <!-- TÌNH TRẠNG -->
                <div class="smart-filter-section">

                    <button type="button"
                            class="smart-filter-collapse">
                        Tình trạng
                    </button>


                    <label class="smart-filter-radio">

                        <input type="radio"
                               name="stockStatus"
                               value=""
                        @(string.IsNullOrWhiteSpace(stockStatus) ? "checked" : "") />

                        <span>
                            Tất cả
                        </span>

                    </label>


                    <label class="smart-filter-radio">

                        <input type="radio"
                               name="stockStatus"
                               value="in_stock"
                        @(stockStatus == "in_stock" ? "checked" : "") />

                        <span>
                            Còn hàng
                        </span>

                    </label>


                    <label class="smart-filter-radio">

                        <input type="radio"
                               name="stockStatus"
                               value="out_stock"
                        @(stockStatus == "out_stock" ? "checked" : "") />

                        <span>
                            Hết hàng
                        </span>

                    </label>

                </div>


                <!-- ĐÁNH GIÁ -->
                <div class="smart-filter-section">

                    <button type="button"
                            class="smart-filter-collapse">
                        Đánh giá
                    </button>


                    <label class="smart-filter-radio">

                        <input type="radio"
                               name="minRating"
                               value=""
                        @(minRating == null ? "checked" : "") />

                        <span>
                            Tất cả đánh giá
                        </span>

                    </label>


                    <label class="smart-filter-radio">

                        <input type="radio"
                               name="minRating"
                               value="5"
                        @(minRating == 5 ? "checked" : "") />

                        <span>
                            ⭐⭐⭐⭐⭐
                        </span>

                    </label>


                    <label class="smart-filter-radio">

                        <input type="radio"
                               name="minRating"
                               value="4"
                        @(minRating == 4 ? "checked" : "") />

                        <span>
                            ⭐⭐⭐⭐ trở lên
                        </span>

                    </label>

                </div>


                <!-- THỜI GIAN GIAO HÀNG -->
                <div class="smart-filter-section">

                    <button type="button"
                            class="smart-filter-collapse">
                        Thời gian giao hàng
                    </button>


                    <label class="smart-filter-radio">

                        <input type="radio"
                               name="deliveryTime"
                               value=""
                        @(string.IsNullOrWhiteSpace(deliveryTime) ? "checked" : "") />

                        <span>
                            Tất cả
                        </span>

                    </label>


                    <label class="smart-filter-radio">

                        <input type="radio"
                               name="deliveryTime"
                               value="1_2"
                        @(deliveryTime == "1_2" ? "checked" : "") />

                        <span>
                            1 - 2 ngày
                        </span>

                    </label>


                    <label class="smart-filter-radio">

                        <input type="radio"
                               name="deliveryTime"
                               value="3_5"
                        @(deliveryTime == "3_5" ? "checked" : "") />

                        <span>
                            3 - 5 ngày
                        </span>

                    </label>

                </div>


                <!-- NÚT LỌC -->
                <div class="smart-filter-actions">

                    <button type="submit"
                            class="btn btn-primary">
                        Lọc sản phẩm
                    </button>


                    <a asp-controller="Product"
                       asp-action="Index"
                       asp-route-categoryId="@currentCategoryId"
                       asp-route-viewMode="@viewMode"
                       class="btn btn-outline-secondary">
                        Xóa lọc
                    </a>

                </div>

            </form>

        </aside>


        <!-- DANH SÁCH SẢN PHẨM -->
        <main class="smart-product-result-panel">

            <div class="smart-product-list-header">

                <div>

                    <h1>
                        @pageTitle
                    </h1>

                    <p>
                        Hiển thị @products.Count sản phẩm
                    </p>

                </div>


                <div class="smart-product-toolbar">

                    <!-- SẮP XẾP -->
                    <form asp-controller="Product"
                          asp-action="Index"
                          method="get"
                          class="smart-sort-form">

                        <input type="hidden"
                               name="categoryId"
                               value="@currentCategoryId" />

                        <input type="hidden"
                               name="search"
                               value="@search" />

                        <input type="hidden"
                               name="minPrice"
                               value="@minPrice" />

                        <input type="hidden"
                               name="maxPrice"
                               value="@maxPrice" />

                        <input type="hidden"
                               name="priceRange"
                               value="@priceRange" />

                        <input type="hidden"
                               name="stockStatus"
                               value="@stockStatus" />

                        <input type="hidden"
                               name="minRating"
                               value="@minRating" />

                        <input type="hidden"
                               name="deliveryTime"
                               value="@deliveryTime" />

                        <input type="hidden"
                               name="viewMode"
                               value="@viewMode" />


                        <select name="sortOrder"
                                class="form-select"
                                onchange="this.form.submit()">

                            <option value="featured"
                                    selected="@(sortOrder == "featured")">
                                Sắp xếp theo nổi bật
                            </option>

                            <option value="price_asc"
                                    selected="@(sortOrder == "price_asc")">
                                Giá tăng dần
                            </option>

                            <option value="price_desc"
                                    selected="@(sortOrder == "price_desc")">
                                Giá giảm dần
                            </option>

                            <option value="newest"
                                    selected="@(sortOrder == "newest")">
                                Mới nhất
                            </option>

                            <option value="name_asc"
                                    selected="@(sortOrder == "name_asc")">
                                Tên A - Z
                            </option>

                            <option value="name_desc"
                                    selected="@(sortOrder == "name_desc")">
                                Tên Z - A
                            </option>

                        </select>

                    </form>


                    <!-- GRID / LIST -->
                    <div class="smart-view-switch">

                        <a asp-controller="Product"
                           asp-action="Index"
                           asp-route-categoryId="@currentCategoryId"
                           asp-route-search="@search"
                           asp-route-globalSearch="@globalSearch"
                           asp-route-minPrice="@minPrice"
                           asp-route-maxPrice="@maxPrice"
                           asp-route-priceRange="@priceRange"
                           asp-route-stockStatus="@stockStatus"
                           asp-route-minRating="@minRating"
                           asp-route-deliveryTime="@deliveryTime"
                           asp-route-sortOrder="@sortOrder"
                           asp-route-viewMode="grid"
                           class="@(viewMode == "grid" ? "active" : "")">
                            ▦
                        </a>


                        <a asp-controller="Product"
                           asp-action="Index"
                           asp-route-categoryId="@currentCategoryId"
                           asp-route-search="@search"
                           asp-route-globalSearch="@globalSearch"
                           asp-route-minPrice="@minPrice"
                           asp-route-maxPrice="@maxPrice"
                           asp-route-priceRange="@priceRange"
                           asp-route-stockStatus="@stockStatus"
                           asp-route-minRating="@minRating"
                           asp-route-deliveryTime="@deliveryTime"
                           asp-route-sortOrder="@sortOrder"
                           asp-route-viewMode="list"
                           class="@(viewMode == "list" ? "active" : "")">
                            ☰
                        </a>

                    </div>

                </div>

            </div>


            @if (products.Any())
            {
                if (viewMode == "list")
                {
                    <div class="smart-product-list-view">

                        @foreach (var item in products)
                        {
                            var discount = GetDiscountPercent(item);

                            var description =
                                string.IsNullOrWhiteSpace(item.Description)
                                    ? "Chưa có mô tả sản phẩm."
                                    : item.Description;

                            var shortDescription =
                                description.Length > 140
                                    ? description.Substring(0, 140) + "..."
                                    : description;


                            <article class="smart-product-list-row smart-hover-product-card">

                                <div class="smart-list-product-image">

                                    @if (discount > 0)
                                    {
                                        <span class="smart-discount-badge">
                                            -@discount%
                                        </span>
                                    }


                                    <a asp-controller="Product"
                                       asp-action="Details"
                                       asp-route-id="@item.Id">

                                        <img src="@item.ImageUrl"
                                             alt="@item.Name"
                                             onerror="this.src='/images/products/no-image.jpg'" />

                                    </a>

                                </div>


                                <div class="smart-list-product-info">

                                    <div class="smart-product-category">
                                        @item.Category?.Name
                                    </div>


                                    <a asp-controller="Product"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="smart-list-product-name">

                                        @item.Name

                                    </a>


                                    <p>
                                        @shortDescription
                                    </p>


                                    @if (item.ProductColors != null &&
                                         item.ProductColors.Any())
                                    {
                                        <div class="smart-color-swatches">

                                            @foreach (var color in item.ProductColors.Take(8))
                                            {
                                                <span title="@color.ColorName"
                                                      style="background:@color.ColorCode">
                                                </span>
                                            }

                                        </div>
                                    }


                                    <div class="smart-delivery-line">

                                        Giao hàng @(string.IsNullOrWhiteSpace(item.DeliveryTime)
                                                                                    ? "3 - 5 ngày"
                                                                                    : item.DeliveryTime)

                                    </div>

                                </div>


                                <div class="smart-list-product-buy">

                                    <div class="smart-list-price">

                                        <strong>
                                            @item.Price.ToString("N0") đ
                                        </strong>


                                        @if (item.OldPrice != null &&
                                             item.OldPrice > item.Price)
                                        {
                                            <small>
                                                Giá cũ:
                                                @item.OldPrice.Value.ToString("N0") đ
                                            </small>
                                        }

                                    </div>


                                    @if (item.StockQuantity > 0)
                                    {
                                        <button type="button"
                                                class="smart-add-cart-btn js-drawer-add-cart"
                                                data-product-id="@item.Id">

                                            🛒 Thêm vào giỏ

                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="smart-out-stock-btn"
                                                disabled>

                                            Hết hàng

                                        </button>
                                    }


                                    <div class="smart-list-icons">

                                        <button type="button"
                                                class="smart-list-icon-btn js-add-wishlist"
                                                data-product-id="@item.Id"
                                                title="Thêm vào yêu thích">
                                            ♡
                                        </button>


                                        <button type="button"
                                                class="smart-list-icon-btn js-add-compare"
                                                data-product-id="@item.Id"
                                                title="Thêm vào so sánh">
                                            ⇄
                                        </button>


                                        <a asp-controller="Product"
                                           asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="smart-list-icon-btn"
                                           title="Xem chi tiết">
                                            ℹ
                                        </a>

                                    </div>

                                </div>

                            </article>
                        }

                    </div>
                }
                else
                {
                    <div class="smart-product-grid-view">

                        @foreach (var item in products)
                        {
                            var discount = GetDiscountPercent(item);

                            var description =
                                string.IsNullOrWhiteSpace(item.Description)
                                    ? "Chưa có mô tả sản phẩm."
                                    : item.Description;

                            var shortDescription =
                                description.Length > 120
                                    ? description.Substring(0, 120) + "..."
                                    : description;


                            <article class="smart-category-product-card smart-hover-product-card">

                                <div class="smart-grid-product-image">

                                    @if (discount > 0)
                                    {
                                        <span class="smart-discount-badge">
                                            -@discount%
                                        </span>
                                    }


                                    @if (item.IsFeatured)
                                    {
                                        <span class="smart-featured-badge">
                                            Nổi bật
                                        </span>
                                    }


                                    <a asp-controller="Product"
                                       asp-action="Details"
                                       asp-route-id="@item.Id">

                                        <img src="@item.ImageUrl"
                                             alt="@item.Name"
                                             onerror="this.src='/images/products/no-image.jpg'" />

                                    </a>

                                </div>


                                <div class="smart-grid-basic-body">

                                    <div class="smart-product-category">
                                        @item.Category?.Name
                                    </div>


                                    <a asp-controller="Product"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="smart-grid-product-name">

                                        @item.Name

                                    </a>


                                    <div class="smart-grid-price">

                                        <strong>
                                            @item.Price.ToString("N0") đ
                                        </strong>


                                        @if (item.OldPrice != null &&
                                             item.OldPrice > item.Price)
                                        {
                                            <small>
                                                Giá cũ:
                                                @item.OldPrice.Value.ToString("N0") đ
                                            </small>
                                        }

                                    </div>

                                </div>


                                <div class="smart-product-hover-preview">

                                    <p>
                                        @shortDescription
                                    </p>


                                    <div class="smart-delivery-line">

                                        ⚪ Giao hàng @(string.IsNullOrWhiteSpace(item.DeliveryTime)
                                                                                    ? "3 - 5 ngày"
                                                                                    : item.DeliveryTime)

                                    </div>


                                    @if (item.ProductColors != null &&
                                         item.ProductColors.Any())
                                    {
                                        <div class="smart-color-swatches">

                                            @foreach (var color in item.ProductColors.Take(8))
                                            {
                                                <span title="@color.ColorName"
                                                      style="background:@color.ColorCode">
                                                </span>
                                            }

                                        </div>
                                    }


                                    <div class="smart-grid-actions">

                                        @if (item.StockQuantity > 0)
                                        {
                                            <button type="button"
                                                    class="js-drawer-add-cart"
                                                    data-product-id="@item.Id"
                                                    title="Thêm vào giỏ">
                                                🛒
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    disabled
                                                    title="Hết hàng">
                                                ✕
                                            </button>
                                        }


                                        <button type="button"
                                                class="js-add-wishlist"
                                                data-product-id="@item.Id"
                                                title="Thêm vào yêu thích">
                                            ♡
                                        </button>


                                        <button type="button"
                                                class="js-add-compare"
                                                data-product-id="@item.Id"
                                                title="Thêm vào so sánh">
                                            ⇄
                                        </button>


                                        <a asp-controller="Product"
                                           asp-action="Details"
                                           asp-route-id="@item.Id"
                                           title="Chi tiết">
                                            ℹ
                                        </a>

                                    </div>

                                </div>

                            </article>
                        }

                    </div>
                }
            }
            else
            {
                <div class="smart-no-product-box">
                    Không tìm thấy sản phẩm phù hợp.
                </div>
            }

        </main>

    </div>

</div>


@functions {

    private int GetDiscountPercent(Product product)
    {
        if (product.OldPrice != null &&
            product.OldPrice > product.Price)
        {
            return (int)Math.Round(
                (1 - product.Price / product.OldPrice.Value) * 100);
        }

        return 0;
    }

}


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            // Xử lý đóng / mở từng nhóm bộ lọc
            const collapseButtons =
                document.querySelectorAll(".smart-filter-collapse");

            collapseButtons.forEach(function(button) {

                const section =
                    button.closest(".smart-filter-section");

                if (!section) return;

                button.addEventListener("click", function() {

                    section.classList.toggle("is-collapsed");

                });

            });


            // ===== LƯU Ý: XỬ LÝ NHẬP KHOẢNG GIÁ LINH HOẠT =====

            const filterForm =
                document.querySelector(".smart-filter-form");

            const minDisplay =
                document.getElementById("priceMinDisplay");

            const maxDisplay =
                document.getElementById("priceMaxDisplay");

            const minHidden =
                document.getElementById("priceMinValue");

            const maxHidden =
                document.getElementById("priceMaxValue");

            const priceError =
                document.getElementById("smartPriceError");

            const priceRangeRadios =
                filterForm
                    ? filterForm.querySelectorAll(
                        'input[name="priceRange"]'
                    )
                    : [];


            function normalizePriceText(value) {

                return (value || "")
                    .trim()
                    .toLowerCase()
                    .normalize("NFD")
                    .replace(/[\u0300-\u036f]/g, "")
                    .replace(/đ/g, "d")
                    .replace(/\s+/g, "");
            }


            function parseGroupedInteger(text) {

                if (/^\d+$/.test(text)) {
                    return Number(text);
                }


                const hasDot =
                    text.includes(".");

                const hasComma =
                    text.includes(",");


                if (hasDot && hasComma) {
                    return null;
                }


                const separator =
                    hasDot
                        ? "."
                        : hasComma
                            ? ","
                            : null;


                if (!separator) {
                    return null;
                }


                const parts =
                    text.split(separator);


                if (parts.length < 2) {
                    return null;
                }


                if (!/^\d{1,3}$/.test(parts[0])) {
                    return null;
                }


                for (let i = 1; i < parts.length; i++) {

                    if (!/^\d{3}$/.test(parts[i])) {
                        return null;
                    }
                }


                return Number(
                    parts.join("")
                );
            }


            function parseMultiplierNumber(text) {

                if (/^\d+$/.test(text)) {
                    return Number(text);
                }


                const dotCount =
                    (text.match(/\./g) || []).length;

                const commaCount =
                    (text.match(/,/g) || []).length;


                if (dotCount > 0 &&
                    commaCount > 0) {

                    const lastDot =
                        text.lastIndexOf(".");

                    const lastComma =
                        text.lastIndexOf(",");

                    const decimalSeparator =
                        lastDot > lastComma
                            ? "."
                            : ",";

                    const groupingSeparator =
                        decimalSeparator === "."
                            ? ","
                            : ".";

                    const decimalIndex =
                        text.lastIndexOf(
                            decimalSeparator
                        );


                    let integerPart =
                        text.substring(
                            0,
                            decimalIndex
                        );

                    const decimalPart =
                        text.substring(
                            decimalIndex + 1
                        );


                    if (!/^\d{1,2}$/.test(decimalPart)) {
                        return null;
                    }


                    integerPart =
                        integerPart
                            .split(groupingSeparator)
                            .join("");


                    if (!/^\d+$/.test(integerPart)) {
                        return null;
                    }


                    return Number(
                        integerPart +
                        "." +
                        decimalPart
                    );
                }


                const separator =
                    dotCount > 0
                        ? "."
                        : commaCount > 0
                            ? ","
                            : null;


                if (!separator) {
                    return null;
                }


                const parts =
                    text.split(separator);


                if (parts.length === 2) {

                    const left =
                        parts[0];

                    const right =
                        parts[1];


                    if (!/^\d+$/.test(left) ||
                        !/^\d+$/.test(right)) {
                        return null;
                    }


                    if (right.length <= 2) {

                        return Number(
                            left +
                            "." +
                            right
                        );
                    }


                    if (right.length === 3) {

                        return Number(
                            left +
                            right
                        );
                    }


                    return null;
                }


                return parseGroupedInteger(text);
            }


            function parseSmartPrice(rawValue) {

                let text =
                    normalizePriceText(rawValue);


                if (text === "") {

                    return {
                        valid: true,
                        empty: true,
                        value: null
                    };
                }


                if (text.startsWith("-")) {

                    return {
                        valid: false,
                        empty: false,
                        value: null
                    };
                }


                let multiplier = 1;
                let hasMultiplier = false;


                if (text.endsWith("trieu")) {

                    multiplier = 1000000;
                    hasMultiplier = true;

                    text =
                        text.substring(
                            0,
                            text.length - 5
                        );
                }

                else if (text.endsWith("tr")) {

                    multiplier = 1000000;
                    hasMultiplier = true;

                    text =
                        text.substring(
                            0,
                            text.length - 2
                        );
                }

                else if (text.endsWith("k")) {

                    multiplier = 1000;
                    hasMultiplier = true;

                    text =
                        text.substring(
                            0,
                            text.length - 1
                        );
                }

                else if (text.endsWith("vnd")) {

                    text =
                        text.substring(
                            0,
                            text.length - 3
                        );
                }

                else if (text.endsWith("d")) {

                    text =
                        text.substring(
                            0,
                            text.length - 1
                        );
                }


                if (text === "") {

                    return {
                        valid: false,
                        empty: false,
                        value: null
                    };
                }


                if (!/^[0-9.,]+$/.test(text)) {

                    return {
                        valid: false,
                        empty: false,
                        value: null
                    };
                }


                let numberValue;


                if (hasMultiplier) {

                    numberValue =
                        parseMultiplierNumber(text);
                }
                else {

                    numberValue =
                        parseGroupedInteger(text);
                }


                if (numberValue === null ||
                    !Number.isFinite(numberValue)) {

                    return {
                        valid: false,
                        empty: false,
                        value: null
                    };
                }


                const finalValue =
                    Math.round(
                        numberValue *
                        multiplier
                    );


                if (finalValue < 0 ||
                    !Number.isSafeInteger(finalValue)) {

                    return {
                        valid: false,
                        empty: false,
                        value: null
                    };
                }


                return {
                    valid: true,
                    empty: false,
                    value: finalValue
                };
            }


            function formatPriceVnd(value) {

                return new Intl.NumberFormat(
                    "vi-VN"
                ).format(value) + " đ";
            }


            function clearPriceError() {

                if (!priceError) return;

                priceError.textContent = "";
                priceError.classList.remove("show");
            }


            function showPriceError(message) {

                if (!priceError) return;

                priceError.textContent =
                    message;

                priceError.classList.add("show");
            }


            function clearPriceRangeSelection() {

                priceRangeRadios.forEach(
                    function(radio) {

                        radio.checked = false;
                    }
                );
            }


            function clearCustomPriceInputs() {

                if (minDisplay) {
                    minDisplay.value = "";
                }

                if (maxDisplay) {
                    maxDisplay.value = "";
                }

                if (minHidden) {
                    minHidden.value = "";
                }

                if (maxHidden) {
                    maxHidden.value = "";
                }
            }


            [
                minDisplay,
                maxDisplay
            ].forEach(function(input) {

                if (!input) return;


                input.addEventListener(
                    "input",
                    function() {

                        clearPriceRangeSelection();
                        clearPriceError();
                    }
                );


                input.addEventListener(
                    "blur",
                    function() {

                        const result =
                            parseSmartPrice(
                                input.value
                            );


                        if (result.valid &&
                            !result.empty) {

                            input.value =
                                formatPriceVnd(
                                    result.value
                                );
                        }
                    }
                );

            });


            priceRangeRadios.forEach(
                function(radio) {

                    radio.addEventListener(
                        "change",
                        function() {

                            if (!this.checked) {
                                return;
                            }

                            clearCustomPriceInputs();
                            clearPriceError();
                        }
                    );

                }
            );


            if (filterForm) {

                filterForm.addEventListener(
                    "submit",
                    function(event) {

                        clearPriceError();


                        const minResult =
                            parseSmartPrice(
                                minDisplay
                                    ? minDisplay.value
                                    : ""
                            );


                        const maxResult =
                            parseSmartPrice(
                                maxDisplay
                                    ? maxDisplay.value
                                    : ""
                            );


                        if (!minResult.valid ||
                            !maxResult.valid) {

                            event.preventDefault();

                            showPriceError(
                                "Vui lòng nhập giá hợp lệ. " +
                                "Ví dụ: 500k, 2tr, 1.5tr, " +
                                "2000000 hoặc 2.000.000đ."
                            );

                            return;
                        }


                        if (!minResult.empty &&
                            !maxResult.empty &&
                            minResult.value >
                            maxResult.value) {

                            event.preventDefault();

                            showPriceError(
                                "Giá từ không được lớn hơn giá đến."
                            );

                            return;
                        }


                        if (minHidden) {

                            minHidden.value =
                                minResult.empty
                                    ? ""
                                    : minResult.value.toString();
                        }


                        if (maxHidden) {

                            maxHidden.value =
                                maxResult.empty
                                    ? ""
                                    : maxResult.value.toString();
                        }
                    }
                );
            }


            [
                minDisplay,
                maxDisplay
            ].forEach(function(input) {

                if (!input ||
                    !input.value.trim()) {
                    return;
                }


                const result =
                    parseSmartPrice(
                        input.value
                    );


                if (result.valid &&
                    !result.empty) {

                    input.value =
                        formatPriceVnd(
                            result.value
                        );
                }

            });

            // ===== KẾT THÚC XỬ LÝ NHẬP KHOẢNG GIÁ LINH HOẠT =====

        });

    </script>

}
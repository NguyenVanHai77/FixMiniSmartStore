@{
    ViewData["Title"] = "About us";
}

<div class="about-page">

    <!-- HERO -->
    <section class="about-hero">
        <div class="about-hero-decoration about-hero-decoration-1"></div>
        <div class="about-hero-decoration about-hero-decoration-2"></div>

        <div class="about-hero-content">
            <span class="about-badge">
                About MiniSmartstore
            </span>

            <h1>About us</h1>

            <p>
                MiniSmartstore là website thương mại điện tử mini được xây dựng bằng
                ASP.NET Core MVC, hỗ trợ quản lý sản phẩm, giỏ hàng, yêu thích,
                so sánh sản phẩm và đặt hàng.
            </p>
        </div>
    </section>


    <!-- ===== LƯU Ý: THÔNG TIN NHÓM HKT ===== -->
    <section class="about-team-section">
        <div class="about-section-heading">
            <div>
                <span class="about-section-label">OUR TEAM</span>
                <h2>Nhóm HKT</h2>
                <p>
                    Danh sách thành viên tham gia xây dựng và phát triển dự án MiniSmartstore.
                </p>
            </div>

            <div class="about-team-count">
                <span>7</span>
                <small>Thành viên</small>
            </div>
        </div>

        <div class="about-team-table-wrapper">
            <table class="about-team-table">
                <thead>
                    <tr>
                        <th>STT</th>
                        <th>Thành viên</th>
                        <th>MSSV</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>01</td>
                        <td>Nguyễn Tấn Tài</td>
                        <td>2311558489</td>
                    </tr>

                    <tr>
                        <td>02</td>
                        <td>Hồ Lâm Minh Thái</td>
                        <td>2311558432</td>
                    </tr>

                    <tr>
                        <td>03</td>
                        <td>Nguyễn Văn Hải</td>
                        <td>2311558475</td>
                    </tr>

                    <tr>
                        <td>04</td>
                        <td>Trần Văn Thế</td>
                        <td>2311558431</td>
                    </tr>

                    <tr>
                        <td>05</td>
